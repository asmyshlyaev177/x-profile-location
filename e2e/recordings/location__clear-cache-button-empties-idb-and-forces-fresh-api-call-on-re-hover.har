00},\"small\":{\"h\":453,\"resize\":\"fit\",\"w\":680},\"thumb\":{\"h\":150,\"resize\":\"crop\",\"w\":150}},\"type\":\"photo\",\"url\":\"https://t.co/arps2DFkPJ\"}]},\"extended_entities\":{\"media\":[{\"allow_download_status\":{\"allow_download\":true},\"display_url\":\"pic.x.com/arps2DFkPJ\",\"expanded_url\":\"https://x.com/sotaproject/status/2105286212361519358/photo/1\",\"ext_media_availability\":{\"status\":\"Available\"},\"features\":{\"large\":{\"faces\":[{\"h\":125,\"w\":125,\"x\":192,\"y\":192},{\"h\":285,\"w\":285,\"x\":708,\"y\":165}]},\"medium\":{\"faces\":[{\"h\":117,\"w\":117,\"x\":180,\"y\":180},{\"h\":267,\"w\":267,\"x\":663,\"y\":154}]},\"orig\":{\"faces\":[{\"h\":125,\"w\":125,\"x\":192,\"y\":192},{\"h\":285,\"w\":285,\"x\":708,\"y\":165}]},\"small\":{\"faces\":[{\"h\":66,\"w\":66,\"x\":102,\"y\":102},{\"h\":151,\"w\":151,\"x\":376,\"y\":87}]}},\"id_str\":\"2105284508249477120\",\"indices\":[278,301],\"media_key\":\"3_2105284508249477120\",\"media_results\":{\"result\":{\"media_key\":\"3_2105284508249477120\"}},\"media_url_https\":\"https://pbs.twimg.com/media/HTd5GyFX0AAujRw.jpg\",\"original_info\":{\"focus_rects\":[{\"h\":717,\"w\":1280,\"x\":0,\"y\":0},{\"h\":853,\"w\":853,\"x\":374,\"y\":0},{\"h\":853,\"w\":748,\"x\":426,\"y\":0},{\"h\":853,\"w\":427,\"x\":587,\"y\":0},{\"h\":853,\"w\":1280,\"x\":0,\"y\":0}],\"height\":853,\"width\":1280},\"sizes\":{\"large\":{\"h\":853,\"resize\":\"fit\",\"w\":1280},\"medium\":{\"h\":800,\"resize\":\"fit\",\"w\":1200},\"small\":{\"h\":453,\"resize\":\"fit\",\"w\":680},\"thumb\":{\"h\":150,\"resize\":\"crop\",\"w\":150}},\"type\":\"photo\",\"url\":\"https://t.co/arps2DFkPJ\"}]},\"favorite_count\":10,\"favorited\":false,\"full_text\":\"Post text removed by scrub-recordings.\",\"id_str\":\"2105286212361519358\",\"is_quote_status\":false,\"lang\":\"ru\",\"possibly_sensitive\":false,\"possibly_sensitive_editable\":true,\"quote_count\":0,\"reply_count\":2,\"retweet_count\":2,\"retweeted\":false,\"user_id_str\":\"1542541675842732032\"},\"note_tweet\":{\"is_expandable\":true,\"note_tweet_results\":{\"result\":{\"entity_set\":{\"hashtags\":[],\"smarttags\":[],\"symbols\":[],\"urls\":[],\"user_mentions\":[]},\"id\":\"Tm90ZVR3ZWV0OjIxMDUyODYyMTIxNDM0NDgwNjQ=\",\"richtext\":{\"richtext_tags\":[]},\"text\":\"Анастасия Шевченко выступила против обмена российских политзаключенных на снятие санкций.\\n\\nНапомним, вчера The Atlantic сообщил о намерении Дональда Трамп ослабить санкции против России в обмен на освобождение политзаключенных: с предложением с подачи Дмитрия Муратова выступил уже добивавшийся успеха в такой схеме с белорусскими политзаключенными спецпосланник Трампа Джон Коул.\\n\\nС осуждением подобного предложения выступила участница «Антивоенного комитета» и создательница фонда поддержки украинских пленных в РФ Анастасия Шевченко:\\n\\n«Я категорически с этим не согласна. Однажды Певчих уже предлагала обменять Горинова на золотой ершик с изъятой яхты Путина. Тогда это казалось неудачной шуткой. Сейчас похожая логика обсуждается всерьез, на уровне Белого дома».\\n\\nМария Певчих высказывала свою идею в начале 2025 года: «Политзеков можно менять на санкции, на частичное снятие санкций. <…> Если бы можно было такие сценарии обговаривать, мне кажется, что здесь человеческая жизнь важнее <…>». \\n\\nШевченко считает, что ослабление санкций поможет Кремлю получить новые ресурсы для войны с Украиной – «а значит, погибнет больше людей».\\n\\nКроме того, по ее мнению, в предложение не входят украинские пленные.\\n\\nОтдельным пунктом Шевченко сослалась на мнение Светланы Тихановской и белорусский опыт: «Если за людей платят снятием санкций, у Кремля появляется понятный стимул сажать еще». Напомним, что при участии Коула на свободу вышел Сергей Тихановский, сейчас подвергающий резкой критике свою жену.\\n\\nВ 2025 году со сходных позиций идею Певчих критиковал и Михаил Ходорковский: «Путин и так постоянно формирует «обменный фонд» для вытаскивания своих агентов, а уж ради снятия санкций... Не уверен, что такой конвейер – хорошая мысль».\\n\\nШевченко предлагает «вытаскивать через обмены, давление и дипломатию»: ранее она настаивала на необходимости арестовать российских участников венецианской биеннале для их обмена на украинских пленных.\\n\\nАнастасия Шевченко. Фото: Денис Галицын / SOTA\"}}},\"previous_counts\":{\"bookmark_count\":0,\"favorite_count\":1,\"quote_count\":0,\"reply_count\":0,\"retweet_count\":0},\"quick_promote_eligibility\":{\"eligibility\":\"IneligibleNotVerified\"},\"rest_id\":\"2105286212361519358\",\"source\":\"<a href=\\\"https://mobile.twitter.com\\\" rel=\\\"nofollow\\\">Twitter Web App</a>\",\"unmention_data\":{},\"views\":{\"count\":\"488\",\"state\":\"EnabledWithCount\"}}}}},\"entryId\":\"tweet-2105286212361519358\",\"sortIndex\":\"2105310577139122173\"},{\"content\":{\"__typename\":\"TimelineTimelineItem\",\"clientEventInfo\":{\"component\":\"organic_tweets\",\"element\":\"tweet\"},\"entryType\":\"TimelineTimelineItem\",\"itemContent\":{\"__typename\":\"TimelineTweet\",\"itemType\":\"TimelineTweet\",\"tweetDisplayType\":\"Tweet\",\"tweet_results\":{\"result\":{\"__typename\":\"Tweet\",\"cashtag_attachments\":[],\"core\":{\"user_results\":{\"result\":{\"__typename\":\"User\",\"action_counts\":{\"favorites_count\":135},\"affiliates_highlighted_label\":{},\"avatar\":{\"image_url\":\"https://abs.twimg.com/sticky/default_profile_images/default_profile_normal.png\"},\"banner\":{\"image_url\":\"https://abs.twimg.com/sticky/default_profile_images/default_profile_normal.png\"},\"core\":{\"created_at\":\"Thu Jun 30 16:13:32 +0000 2022\",\"name\":\"SOTA\",\"screen_name\":\"sotaproject\"},\"follow_request_sent\":false,\"has_graduated_access\":true,\"id\":\"VXNlcjoxNTQyNTQxNjc1ODQyNzMyMDMy\",\"is_blue_verified\":true,\"location\":{\"location\":\"\"},\"media_permissions\":{\"can_media_tag\":true},\"notifications_settings\":{\"notifications_enabled\":false},\"parody_commentary_fan_label\":\"None\",\"pinned_items\":{},\"possibly_sensitive\":false,\"privacy\":{\"protected\":false},\"professional\":{\"category\":[{\"icon_name\":\"IconBriefcaseStroke\",\"id\":580,\"name\":\"Media & News Company\"}],\"professional_type\":\"Business\",\"rest_id\":\"1542542586447106049\"},\"profile_bio\":{\"description\":\"Наверное, лучшее российское СМИ.\\nПочта редакции: mail@sotaproject.com\\ntelegram: https://t.co/A8MN1X46oo\\nАнглоязычный твиттер: https://t.co/JCBSoWBuSH\",\"entities\":{\"description\":{\"urls\":[{\"display_url\":\"t.me/sotaproject\",\"expanded_url\":\"http://t.me/sotaproject\",\"indices\":[80,103],\"url\":\"https://t.co/A8MN1X46oo\"},{\"display_url\":\"twitter.com/sotanews\",\"expanded_url\":\"https://twitter.com/sotanews\",\"indices\":[126,149],\"url\":\"https://t.co/JCBSoWBuSH\"}]},\"url\":{\"urls\":[{\"display_url\":\"t.me/sotaproject\",\"expanded_url\":\"https://t.me/sotaproject\",\"indices\":[0,23],\"url\":\"https://t.co/ygcizj0jWn\"}]}}},\"profile_description_language\":\"ru\",\"profile_image_shape\":\"Circle\",\"profile_metadata\":{\"profile_interstitial_type\":\"\"},\"profile_translation\":{\"translator_type\":\"none\"},\"relationship_counts\":{\"followers\":8371,\"following\":156},\"relationship_perspectives\":{\"blocked_by\":false,\"blocking\":false,\"followed_by\":false,\"following\":false,\"live_following\":false,\"muting\":false},\"rest_id\":\"1542541675842732032\",\"super_follow_eligible\":false,\"super_followed_by\":false,\"super_following\":false,\"tweet_counts\":{\"media_tweets\":19628,\"tweets\":30464},\"verification\":{\"verified\":false},\"website\":{\"url\":\"https://t.co/ygcizj0jWn\"}}}},\"edit_control\":{\"edit_tweet_ids\":[\"2105283635305660727\"],\"editable_until_msecs\":\"1790777307000\",\"edits_remaining\":\"5\",\"is_edit_eligible\":true},\"grok_analysis_button\":true,\"grok_annotations\":{\"is_image_editable_by_grok\":false},\"grok_translated_post_with_availability\":{\"is_available\":false},\"is_translatable\":false,\"legacy\":{\"bookmark_count\":0,\"bookmarked\":false,\"conversation_id_str\":\"2105283635305660727\",\"created_at\":\"Wed Sep 30 13:08:27 +0000 2026\",\"display_text_range\":[0,278],\"entities\":{},\"favorite_count\":5,\"favorited\":false,\"full_text\":\"Post text removed by scrub-recordings.\",\"id_str\":\"2105283635305660727\",\"is_quote_status\":false,\"lang\":\"ru\",\"quote_count\":0,\"reply_count\":0,\"retweet_count\":0,\"retweeted\":false,\"user_id_str\":\"1542541675842732032\"},\"note_tweet\":{\"is_expandable\":true,\"note_tweet_results\":{\"result\":{\"entity_set\":{\"hashtags\":[],\"smarttags\":[],\"symbols\":[],\"urls\":[],\"user_mentions\":[]},\"id\":\"Tm90ZVR3ZWV0OjIxMDUyODM2MzUxNzk5Mjk2MDA=\",\"text\":\"В Якутии уволили директоров школы и детсада после проигрыша «Единой России» на размещенных там избирательных участках\\n\\nВ селе Хоро Верхневилюйского района Якутии уволили директора школы и заведующую детским садом после того, как «Единая Россия» проиграла на расположенных в этих учреждениях избирательных участках. Об этом сообщает SakhLife со ссылкой на бывшего руководителя районного управления образования Спиридона Борбуева.\\n\\nНа выборах в Госдуму в Хоро КПРФ получила 182 голоса, а «Единая Россия» — 119. По словам Борбуева, после такого результата руководство района посчитало ответственными за поражение партии директора школы и заведующую детским садом, где проходило голосование. \\n\\nОбоим руководителям 29 сентября вручили приказы об увольнении по пункту 2 части 1 статьи 278 Трудового кодекса. Эта норма позволяет прекратить трудовой договор с руководителем организации по решению собственника или уполномоченного органа.\"}}},\"quick_promote_eligibility\":{\"eligibility\":\"IneligibleNotVerified\"},\"rest_id\":\"2105283635305660727\",\"source\":\"<a href=\\\"http://twitter.com/download/iphone\\\" rel=\\\"nofollow\\\">Twitter for iPhone</a>\",\"unmention_data\":{},\"views\":{\"count\":\"350\",\"state\":\"EnabledWithCount\"}}}}},\"entryId\":\"tweet-2105283635305660727\",\"sortIndex\":\"2105310577139122172\"},{\"content\":{\"__typename\":\"TimelineTimelineModule\",\"clientEventInfo\":{\"component\":\"suggest_who_to_follow\",\"details\":{\"timelinesDetails\":{\"controllerData\":\"DAACDAACDAABCgABAAAAAAAAAAgAAAAA\",\"injectionType\":\"WhoToFollow\",\"sourceData\":\"DAABCgAB1+m5lydMFZUKAAIAAAAAAAAAAAAIAAIAAACDCAADAAAAAgwABQwAAgwAAgwAAQoAAQAAAAAAAAAIAAAAAAA=\"}}},\"displayType\":\"Vertical\",\"entryType\":\"TimelineTimelineModule\",\"footer\":{\"displayType\":\"Classic\",\"landingUrl\":{\"url\":\"twitter://connect_people?user_id=1542541675842732032&display_location=profile_wtf_showmore\",\"urlType\":\"DeepLink\"},\"text\":\"Show more\"},\"header\":{\"displayType\":\"Classic\",\"sticky\":false,\"text\":\"Who to follow\"},\"items\":[{\"entryId\":\"who-to-follow-2105310577139122181-user-968035508\",\"item\":{\"clientEventInfo\":{\"component\":\"suggest_who_to_follow\",\"details\":{\"timelinesDetails\":{\"controllerData\":\"DAACDAACDAABCgABAAAAAAAAAAgAAAAA\",\"injectionType\":\"WhoToFollow\",\"sourceData\":\"DAABCgAB1+m5lydMFZUKAAIAAAAAAAAAAAAIAAIAAACDCAADAAAAAgwABQwAAgwAAgwAAQoAAQAAAAAAAAAIAAAAAAA=\"}},\"element\":\"user\"},\"itemContent\":{\"__typename\":\"TimelineUser\",\"itemType\":\"TimelineUser\",\"userDisplayType\":\"User\",\"user_results\":{\"result\":{\"__typename\":\"User\",\"action_counts\":{\"favorites_count\":1639},\"affiliates_highlighted_label\":{},\"avatar\":{\"image_url\":\"https://abs.twimg.com/sticky/default_profile_images/default_profile_normal.png\"},\"banner\":{\"image_url\":\"https://abs.twimg.com/sticky/default_profile_images/default_profile_normal.png\"},\"core\":{\"created_at\":\"Sat Nov 24 13:33:40 +0000 2012\",\"name\":\"User 8af5\",\"screen_name\":\"user_8af5b323\"},\"follow_request_sent\":false,\"has_graduated_access\":true,\"id\":\"VXNlcjo5NjgwMzU1MDg=\",\"is_blue_verified\":true,\"location\":{\"location\":\"\"},\"media_permissions\":{\"can_media_tag\":true},\"notifications_settings\":{\"notifications_enabled\":false},\"parody_commen
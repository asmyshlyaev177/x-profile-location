tps://pbs.twimg.com/media/HTcr9EWXkAAfw7e.jpg\",\"original_info\":{\"focus_rects\":[{\"h\":345,\"w\":616,\"x\":0,\"y\":0},{\"h\":616,\"w\":616,\"x\":0,\"y\":0},{\"h\":702,\"w\":616,\"x\":0,\"y\":0},{\"h\":919,\"w\":460,\"x\":0,\"y\":0},{\"h\":919,\"w\":616,\"x\":0,\"y\":0}],\"height\":919,\"width\":616},\"sizes\":{\"large\":{\"h\":919,\"resize\":\"fit\",\"w\":616},\"medium\":{\"h\":919,\"resize\":\"fit\",\"w\":616},\"small\":{\"h\":680,\"resize\":\"fit\",\"w\":456},\"thumb\":{\"h\":150,\"resize\":\"crop\",\"w\":150}},\"type\":\"photo\",\"url\":\"https://t.co/bOto1trS5H\"},{\"allow_download_status\":{\"allow_download\":true},\"display_url\":\"pic.x.com/bOto1trS5H\",\"expanded_url\":\"https://x.com/sotaproject/status/2105199700382986322/photo/1\",\"ext_media_availability\":{\"status\":\"Available\"},\"features\":{\"large\":{\"faces\":[]},\"medium\":{\"faces\":[]},\"orig\":{\"faces\":[]},\"small\":{\"faces\":[]}},\"id_str\":\"2105199694460719104\",\"indices\":[275,298],\"media_key\":\"3_2105199694460719104\",\"media_results\":{\"result\":{\"media_key\":\"3_2105199694460719104\"}},\"media_url_https\":\"https://pbs.twimg.com/media/HTcr9-GXkAAoMty.jpg\",\"original_info\":{\"focus_rects\":[{\"h\":323,\"w\":576,\"x\":0,\"y\":224},{\"h\":576,\"w\":576,\"x\":0,\"y\":97},{\"h\":657,\"w\":576,\"x\":0,\"y\":57},{\"h\":907,\"w\":454,\"x\":122,\"y\":0},{\"h\":907,\"w\":576,\"x\":0,\"y\":0}],\"height\":907,\"width\":576},\"sizes\":{\"large\":{\"h\":907,\"resize\":\"fit\",\"w\":576},\"medium\":{\"h\":907,\"resize\":\"fit\",\"w\":576},\"small\":{\"h\":680,\"resize\":\"fit\",\"w\":432},\"thumb\":{\"h\":150,\"resize\":\"crop\",\"w\":150}},\"type\":\"photo\",\"url\":\"https://t.co/bOto1trS5H\"}]},\"favorite_count\":4,\"favorited\":false,\"full_text\":\"Post text removed by scrub-recordings.\",\"id_str\":\"2105199700382986322\",\"is_quote_status\":false,\"lang\":\"ru\",\"possibly_sensitive\":false,\"possibly_sensitive_editable\":true,\"quote_count\":1,\"reply_count\":0,\"retweet_count\":0,\"retweeted\":false,\"user_id_str\":\"1542541675842732032\"},\"note_tweet\":{\"is_expandable\":true,\"note_tweet_results\":{\"result\":{\"entity_set\":{\"hashtags\":[],\"smarttags\":[],\"symbols\":[],\"urls\":[],\"user_mentions\":[]},\"id\":\"Tm90ZVR3ZWV0OjIxMDUxOTk3MDAyODY1MDkwNTY=\",\"richtext\":{\"richtext_tags\":[]},\"text\":\"На новосибирца составили протокол за призыв не поддерживать «Единую Россию».\\n\\nФигурантом протокола стал житель Новосибирска Сергей Волков: ролик с его призывом был опубликован в ютюбе 7 сентября.\\n\\nС точки зрения областного избиркома и, как утверждает опубликовавшая документ политик Светлана Каверзина, центра «Э», выражение своего мнения о политике в предвыборный период является нарушением статьи 5.12 КоАП: «Изготовление, распространение или размещение агитационных материалов с нарушением требований законодательства о выборах и референдумах» (штраф для физических лиц до 25 тысяч рублей).\"}}},\"quick_promote_eligibility\":{\"eligibility\":\"IneligibleNotVerified\"},\"rest_id\":\"2105199700382986322\",\"source\":\"<a href=\\\"https://mobile.twitter.com\\\" rel=\\\"nofollow\\\">Twitter Web App</a>\",\"unmention_data\":{},\"views\":{\"count\":\"385\",\"state\":\"EnabledWithCount\"}}}}},\"entryId\":\"tweet-2105199700382986322\",\"sortIndex\":\"2105310577139122161\"},{\"content\":{\"__typename\":\"TimelineTimelineItem\",\"clientEventInfo\":{\"component\":\"organic_tweets\",\"element\":\"tweet\"},\"entryType\":\"TimelineTimelineItem\",\"itemContent\":{\"__typename\":\"TimelineTweet\",\"itemType\":\"TimelineTweet\",\"tweetDisplayType\":\"Tweet\",\"tweet_results\":{\"result\":{\"__typename\":\"Tweet\",\"cashtag_attachments\":[],\"core\":{\"user_results\":{\"result\":{\"__typename\":\"User\",\"action_counts\":{\"favorites_count\":135},\"affiliates_highlighted_label\":{},\"avatar\":{\"image_url\":\"https://abs.twimg.com/sticky/default_profile_images/default_profile_normal.png\"},\"banner\":{\"image_url\":\"https://abs.twimg.com/sticky/default_profile_images/default_profile_normal.png\"},\"core\":{\"created_at\":\"Thu Jun 30 16:13:32 +0000 2022\",\"name\":\"SOTA\",\"screen_name\":\"sotaproject\"},\"follow_request_sent\":false,\"has_graduated_access\":true,\"id\":\"VXNlcjoxNTQyNTQxNjc1ODQyNzMyMDMy\",\"is_blue_verified\":true,\"location\":{\"location\":\"\"},\"media_permissions\":{\"can_media_tag\":true},\"notifications_settings\":{\"notifications_enabled\":false},\"parody_commentary_fan_label\":\"None\",\"pinned_items\":{},\"possibly_sensitive\":false,\"privacy\":{\"protected\":false},\"professional\":{\"category\":[{\"icon_name\":\"IconBriefcaseStroke\",\"id\":580,\"name\":\"Media & News Company\"}],\"professional_type\":\"Business\",\"rest_id\":\"1542542586447106049\"},\"profile_bio\":{\"description\":\"Наверное, лучшее российское СМИ.\\nПочта редакции: mail@sotaproject.com\\ntelegram: https://t.co/A8MN1X46oo\\nАнглоязычный твиттер: https://t.co/JCBSoWBuSH\",\"entities\":{\"description\":{\"urls\":[{\"display_url\":\"t.me/sotaproject\",\"expanded_url\":\"http://t.me/sotaproject\",\"indices\":[80,103],\"url\":\"https://t.co/A8MN1X46oo\"},{\"display_url\":\"twitter.com/sotanews\",\"expanded_url\":\"https://twitter.com/sotanews\",\"indices\":[126,149],\"url\":\"https://t.co/JCBSoWBuSH\"}]},\"url\":{\"urls\":[{\"display_url\":\"t.me/sotaproject\",\"expanded_url\":\"https://t.me/sotaproject\",\"indices\":[0,23],\"url\":\"https://t.co/ygcizj0jWn\"}]}}},\"profile_description_language\":\"ru\",\"profile_image_shape\":\"Circle\",\"profile_metadata\":{\"profile_interstitial_type\":\"\"},\"profile_translation\":{\"translator_type\":\"none\"},\"relationship_counts\":{\"followers\":8371,\"following\":156},\"relationship_perspectives\":{\"blocked_by\":false,\"blocking\":false,\"followed_by\":false,\"following\":false,\"live_following\":false,\"muting\":false},\"rest_id\":\"1542541675842732032\",\"super_follow_eligible\":false,\"super_followed_by\":false,\"super_following\":false,\"tweet_counts\":{\"media_tweets\":19628,\"tweets\":30464},\"verification\":{\"verified\":false},\"website\":{\"url\":\"https://t.co/ygcizj0jWn\"}}}},\"edit_control\":{\"edit_tweet_ids\":[\"2105196818132836457\"],\"editable_until_msecs\":\"1790756608000\",\"edits_remaining\":\"5\",\"is_edit_eligible\":true},\"grok_analysis_button\":true,\"grok_annotations\":{},\"grok_translated_post_with_availability\":{\"is_available\":false},\"is_translatable\":true,\"legacy\":{\"bookmark_count\":0,\"bookmarked\":false,\"conversation_id_str\":\"2105196818132836457\",\"created_at\":\"Wed Sep 30 07:23:28 +0000 2026\",\"display_text_range\":[0,274],\"entities\":{},\"favorite_count\":0,\"favorited\":false,\"full_text\":\"Post text removed by scrub-recordings.\",\"id_str\":\"2105196818132836457\",\"is_quote_status\":false,\"lang\":\"ru\",\"quote_count\":0,\"reply_count\":1,\"retweet_count\":0,\"retweeted\":false,\"user_id_str\":\"1542541675842732032\"},\"note_tweet\":{\"is_expandable\":true,\"note_tweet_results\":{\"result\":{\"entity_set\":{\"hashtags\":[],\"smarttags\":[],\"symbols\":[],\"urls\":[],\"user_mentions\":[]},\"id\":\"Tm90ZVR3ZWV0OjIxMDUxOTY4MTgwMDI3NjM3NzY=\",\"richtext\":{\"richtext_tags\":[{\"from_index\":0,\"richtext_types\":[\"Bold\"],\"to_index\":97}]},\"text\":\"Посольство России в Ирландии пригрозило ядерным оружием в случае изоляции Калининградской области\\n\\nОб этом говорится в заявлении российского диппредставительства.\\n\\n«Россия будет готова использовать весь свой арсенал, включая ядерное оружие, для защиты своей территории, если страны НАТО попытаются изолировать Калининградскую область от остальной части страны», — говорится в документе.\\n\\nВ посольстве также допустили возможность превентивных ударов по центрам принятия решений в странах НАТО на ранней стадии конфликта.\\n\\nДиппредставительство сослалось на сведения о подготовке воздушной и морской блокады региона, но не указало их источники. При этом в посольстве утверждают, что Москва не планирует обострять отношения с Европой.\\n\\nРанее посольство России в Великобритании также предупреждало о возможном применении ядерного оружия в ответ на военные действия против российской территории. Так оно отреагировало на публикацию The i Paper о возможном отказе стран НАТО признавать российский суверенитет над Калининградской областью. Диппредставительство также упомянуло проект Sky News The Wargame, в котором рассматривался сценарий конфликта с Россией и возможного удара по региону.\"}}},\"quick_promote_eligibility\":{\"eligibility\":\"IneligibleNotVerified\"},\"rest_id\":\"2105196818132836457\",\"source\":\"<a href=\\\"https://mobile.twitter.com\\\" rel=\\\"nofollow\\\">Twitter Web App</a>\",\"unmention_data\":{},\"views\":{\"count\":\"280\",\"state\":\"EnabledWithCount\"}}}}},\"entryId\":\"tweet-2105196818132836457\",\"sortIndex\":\"2105310577139122160\"},{\"content\":{\"__typename\":\"TimelineTimelineItem\",\"clientEventInfo\":{\"component\":\"organic_tweets\",\"element\":\"tweet\"},\"entryType\":\"TimelineTimelineItem\",\"itemContent\":{\"__typename\":\"TimelineTweet\",\"itemType\":\"TimelineTweet\",\"tweetDisplayType\":\"Tweet\",\"tweet_results\":{\"result\":{\"__typename\":\"Tweet\",\"cashtag_attachments\":[],\"core\":{\"user_results\":{\"result\":{\"__typename\":\"User\",\"action_counts\":{\"favorites_count\":135},\"affiliates_highlighted_label\":{},\"avatar\":{\"image_url\":\"https://abs.twimg.com/sticky/default_profile_images/default_profile_normal.png\"},\"banner\":{\"image_url\":\"https://abs.twimg.com/sticky/default_profile_images/default_profile_normal.png\"},\"core\":{\"created_at\":\"Thu Jun 30 16:13:32 +0000 2022\",\"name\":\"SOTA\",\"screen_name\":\"sotaproject\"},\"follow_request_sent\":false,\"has_graduated_access\":true,\"id\":\"VXNlcjoxNTQyNTQxNjc1ODQyNzMyMDMy\",\"is_blue_verified\":true,\"location\":{\"location\":\"\"},\"media_permissions\":{\"can_media_tag\":true},\"notifications_settings\":{\"notifications_enabled\":false},\"parody_commentary_fan_label\":\"None\",\"pinned_items\"
[277,300],\"media_key\":\"3_2105182502843281408\",\"media_results\":{\"result\":{\"media_key\":\"3_2105182502843281408\"}},\"media_url_https\":\"https://pbs.twimg.com/media/HTccVSVXcAAZ7aQ.jpg\",\"original_info\":{\"focus_rects\":[{\"h\":717,\"w\":1280,\"x\":0,\"y\":0},{\"h\":720,\"w\":720,\"x\":0,\"y\":0},{\"h\":720,\"w\":632,\"x\":0,\"y\":0},{\"h\":720,\"w\":360,\"x\":0,\"y\":0},{\"h\":720,\"w\":1280,\"x\":0,\"y\":0}],\"height\":720,\"width\":1280},\"sizes\":{\"large\":{\"h\":720,\"resize\":\"fit\",\"w\":1280},\"medium\":{\"h\":675,\"resize\":\"fit\",\"w\":1200},\"small\":{\"h\":383,\"resize\":\"fit\",\"w\":680},\"thumb\":{\"h\":150,\"resize\":\"crop\",\"w\":150}},\"type\":\"photo\",\"url\":\"https://t.co/lZVKHJfd8z\"}]},\"favorite_count\":0,\"favorited\":false,\"full_text\":\"Post text removed by scrub-recordings.\",\"id_str\":\"2105182511571623977\",\"is_quote_status\":false,\"lang\":\"ru\",\"possibly_sensitive\":false,\"possibly_sensitive_editable\":true,\"quote_count\":0,\"reply_count\":1,\"retweet_count\":0,\"retweeted\":false,\"user_id_str\":\"1542541675842732032\"},\"note_tweet\":{\"is_expandable\":true,\"note_tweet_results\":{\"result\":{\"entity_set\":{\"hashtags\":[],\"smarttags\":[],\"symbols\":[],\"urls\":[],\"user_mentions\":[]},\"id\":\"Tm90ZVR3ZWV0OjIxMDUxODI1MTE0NDk5MTEyOTY=\",\"richtext\":{\"richtext_tags\":[{\"from_index\":0,\"richtext_types\":[\"Bold\"],\"to_index\":82}]},\"text\":\"При российских ударах по Киеву и области погибли три человека, еще семь пострадали\\n\\nОб этом сообщила Государственная служба Украины по чрезвычайным ситуациям.\\n\\nВечером 29 сентября и в ночь на 30 сентября в Киеве в результате российских ударов погибли два человека, еще четверо пострадали. Пожары и разрушения зафиксировали в Святошинском, Подольском, Голосеевском и Соломенском районах.\\n\\nВ Святошинском районе сгорел частный дом и были повреждены еще около десяти. В Подольском районе удары пришлись по нежилому и складскому зданиям, также загорелся двухэтажный частный дом. В Голосеевском и Соломенском районах произошли пожары, которые спасатели потушили.\\n\\nЕще один человек погиб в Вышгороде Киевской области. После российского ракетного удара был разрушен частный дом, под его обломками спасатели обнаружили ребенка 2012 года рождения, которого не удалось спасти. Еще три человека получили ранения, среди них также ребенок.\"}}},\"quick_promote_eligibility\":{\"eligibility\":\"IneligibleNotVerified\"},\"rest_id\":\"2105182511571623977\",\"source\":\"<a href=\\\"https://mobile.twitter.com\\\" rel=\\\"nofollow\\\">Twitter Web App</a>\",\"unmention_data\":{},\"views\":{\"count\":\"236\",\"state\":\"EnabledWithCount\"}}}}},\"entryId\":\"tweet-2105182511571623977\",\"sortIndex\":\"2105310577139122159\"},{\"content\":{\"__typename\":\"TimelineTimelineItem\",\"clientEventInfo\":{\"component\":\"organic_tweets\",\"element\":\"tweet\"},\"entryType\":\"TimelineTimelineItem\",\"itemContent\":{\"__typename\":\"TimelineTweet\",\"itemType\":\"TimelineTweet\",\"tweetDisplayType\":\"Tweet\",\"tweet_results\":{\"result\":{\"__typename\":\"Tweet\",\"cashtag_attachments\":[],\"core\":{\"user_results\":{\"result\":{\"__typename\":\"User\",\"action_counts\":{\"favorites_count\":135},\"affiliates_highlighted_label\":{},\"avatar\":{\"image_url\":\"https://abs.twimg.com/sticky/default_profile_images/default_profile_normal.png\"},\"banner\":{\"image_url\":\"https://abs.twimg.com/sticky/default_profile_images/default_profile_normal.png\"},\"core\":{\"created_at\":\"Thu Jun 30 16:13:32 +0000 2022\",\"name\":\"SOTA\",\"screen_name\":\"sotaproject\"},\"follow_request_sent\":false,\"has_graduated_access\":true,\"id\":\"VXNlcjoxNTQyNTQxNjc1ODQyNzMyMDMy\",\"is_blue_verified\":true,\"location\":{\"location\":\"\"},\"media_permissions\":{\"can_media_tag\":true},\"notifications_settings\":{\"notifications_enabled\":false},\"parody_commentary_fan_label\":\"None\",\"pinned_items\":{},\"possibly_sensitive\":false,\"privacy\":{\"protected\":false},\"professional\":{\"category\":[{\"icon_name\":\"IconBriefcaseStroke\",\"id\":580,\"name\":\"Media & News Company\"}],\"professional_type\":\"Business\",\"rest_id\":\"1542542586447106049\"},\"profile_bio\":{\"description\":\"Наверное, лучшее российское СМИ.\\nПочта редакции: mail@sotaproject.com\\ntelegram: https://t.co/A8MN1X46oo\\nАнглоязычный твиттер: https://t.co/JCBSoWBuSH\",\"entities\":{\"description\":{\"urls\":[{\"display_url\":\"t.me/sotaproject\",\"expanded_url\":\"http://t.me/sotaproject\",\"indices\":[80,103],\"url\":\"https://t.co/A8MN1X46oo\"},{\"display_url\":\"twitter.com/sotanews\",\"expanded_url\":\"https://twitter.com/sotanews\",\"indices\":[126,149],\"url\":\"https://t.co/JCBSoWBuSH\"}]},\"url\":{\"urls\":[{\"display_url\":\"t.me/sotaproject\",\"expanded_url\":\"https://t.me/sotaproject\",\"indices\":[0,23],\"url\":\"https://t.co/ygcizj0jWn\"}]}}},\"profile_description_language\":\"ru\",\"profile_image_shape\":\"Circle\",\"profile_metadata\":{\"profile_interstitial_type\":\"\"},\"profile_translation\":{\"translator_type\":\"none\"},\"relationship_counts\":{\"followers\":8371,\"following\":156},\"relationship_perspectives\":{\"blocked_by\":false,\"blocking\":false,\"followed_by\":false,\"following\":false,\"live_following\":false,\"muting\":false},\"rest_id\":\"1542541675842732032\",\"super_follow_eligible\":false,\"super_followed_by\":false,\"super_following\":false,\"tweet_counts\":{\"media_tweets\":19628,\"tweets\":30464},\"verification\":{\"verified\":false},\"website\":{\"url\":\"https://t.co/ygcizj0jWn\"}}}},\"edit_control\":{\"edit_tweet_ids\":[\"2105043207666946091\"],\"editable_until_msecs\":\"1790719985000\",\"edits_remaining\":\"5\",\"is_edit_eligible\":true},\"grok_analysis_button\":true,\"grok_annotations\":{},\"grok_translated_post_with_availability\":{\"data\":{\"associated_data\":{},\"destination_language\":\"en\",\"entities\":{\"hashtags\":[],\"symbols\":[],\"urls\":[],\"user_mentions\":[]},\"preview_translation\":\"In Russia, delivery robot operators are required to insure against collisions with people\\n⠀\\nOperators of delivery robots must insure the liability of each device for at least 500 thousand rubles. The rules took effect on September 26 as part of a three-year experiment covering\",\"source_language\":\"ru\",\"translation\":\"In Russia, delivery robot operators are required to insure against collisions with people\\n⠀\\nOperators of delivery robots must insure the liability of each device for at least 500 thousand rubles. The rules took effect on September 26 as part of a three-year experiment covering 34 regions.\\n⠀\\nRovers are permitted to travel on bike lanes, sidewalks, pedestrian zones, courtyards, and inside buildings. On sidewalks and in pedestrian zones, they will be able to move no faster than 10 km/h, and when crossing a road at a zebra crossing—up to 6 km/h.\\n⠀\\nIn the event of an accident, the dispatcher will assess the situation via the robot's cameras. If people are injured or property is damaged, the rover must stop, and a representative of the operator must arrive at the scene within four hours.\\n⠀\\nEarlier, we reported that the Ministry of Economic Development had prepared a draft of rules for rovers. At that time, the authorities planned to launch them in 37 regions and increase the fleet to 2,600 devices over three years.\"},\"is_available\":true},\"is_translatable\":false,\"legacy\":{\"bookmark_count\":0,\"bookmarked\":false,\"conversation_id_str\":\"2105043207666946091\",\"created_at\":\"Tue Sep 29 21:13:05 +0000 2026\",\"display_text_range\":[0,276],\"entities\":{},\"favorite_count\":0,\"favorited\":false,\"full_text\":\"Post text removed by scrub-recordings.\",\"id_str\":\"2105043207666946091\",\"is_quote_status\":false,\"lang\":\"ru\",\"quote_count\":0,\"reply_count\":0,\"retweet_count\":0,\"retweeted\":false,\"user_id_str\":\"1542541675842732032\"},\"note_tweet\":{\"is_expandable\":true,\"note_tweet_results\":{\"result\":{\"entity_set\":{\"hashtags\":[],\"smarttags\":[],\"symbols\":[],\"urls\":[],\"user_mentions\":[]},\"id\":\"Tm90ZVR3ZWV0OjIxMDUwNDMyMDc1NzQ3MzI4MDA=\",\"text\":\"В России роботов-курьеров обязали страховать на случай наезда на людей\\n⠀\\nОператоры роботов-доставщиков должны застраховать ответственность каждого устройства минимум на 500 тысяч рублей. Правила вступили в силу 26 сентября в рамках трёхлетнего эксперимента, который охватит 34 региона.\\n⠀\\nРоверам разрешили ездить по велодорожкам, тротуарам, пешеходным зонам, дворам и внутри зданий. На тротуарах и в пешеходных зонах они смогут двигаться не быстрее 10 км/ч, при пересечении дороги по «зебре» — до 6 км/ч.\\n⠀\\nПри аварии диспетчер оценит ситуацию через камеры робота. Если пострадали люди или повреждено имущество, ровер должен остановиться, а представитель оператора приехать на место в течение четырёх часов.\\n⠀\\nРанее мы писали, что Минэкономики подготовило проект правил для роверов. Тогда власти планировали запустить их в 37 регионах и увеличить парк до 2,6 тысячи устройств за три года.\"}}},\"quick_promote_eligibility\":{\"eligibility\":\"IneligibleNotVerified\"},\"rest_id\":\"2105043207666946091\",\"source\":\"<a href=\\\"http://twitter.com/download/iphone\\\" rel=\\\"nofollow\\\">Twitter for iPhone</a>\",\"unmention_data\":{},\"views\":{\"count\":\"323\",\"state\":\"EnabledWithCount\"}}}}},\"entryId\":\"tweet-2105043207666946091\",\"sortIndex\":\"2105310577139122158\"},{\"content\":{\"__typename\":\"TimelineTimelineItem\",\"clientEventInfo\":{\"component\":\"organic_tweets\",\"element\":\"tweet\"},\"entryType\":\"TimelineTimelineItem\",\"itemContent\":{\"__typename\":\"TimelineTweet\",\"itemType\":\"TimelineTweet\",\"tweetDisplayType\":\"Tweet\",\"tweet_results\":{\"result\":{\"__typename\":\"Tweet\",\"cashtag_attachments\":[],\"core\":{\"user_results\":{\"result\":{\"__typename\":\"User\",\"action_counts\":{\"favorites_count\":135},\"affiliates_highlighted_label\":{},\"avatar\":{\"image_url\":\"https://abs.twimg.com/sticky/default_profile_images/default_profile_normal.png\"},\"banner\":{\"image_url\":\"https://abs.twimg.com/sticky/default_profile_images/default_profile_normal.png\"},\"core\":{\"created_at\":\"Thu Jun 30 16:13:32 +0000 2022\",\"name\":\"SOTA\",\"screen_name\":\"sotaproject\"},\"follow_request_sent\":false,\"has_graduated_access\":true,\"id\":\"VXNlcjoxNTQyNTQxNjc1ODQyNzMyMDMy\",\"is_blue_verified\":true,\"location\":{\"location\":\"\"},\"media_permissions\":{\"can_media_tag\":true},\"notifications_settings\":{\"notifications_enabled\":false},\"parody_commentary_fan_label\":\"None\",\"pinned_items\":{},\"possibly_sensitive\":false,\"privacy\":{\"protected\":false},\"professional\":{\"category\":[{\"icon_name\":\"IconBriefcaseStroke\",\"id\":580,\"name\":\"Media & News Company\"}],\"professional_type\":\"Business\",\"rest_id\":\"1542542586447106049\"},\"profile_bio\":{\"description\":\"Наверное, лучшее российское СМИ.\\nПочта редакции: mail@sotaproject.com\\ntelegram: https://t.co/A8MN1X46oo\\nАнглоязычный твиттер: https://t.co/JCBSoWBuSH\",\"entities\":{\"description\":{\"urls\":[{\"display_url\":\"t.me/sotaproject\",\"expanded_url\":\"http://t.me/sotaproject\",\"indices\":[80,103],\"url\":\"https://t.co/A8MN1X46oo\"},{\"display_url\":\"twitter.com/sotanews\",\"expanded_url\":\"https://twitter.com/sotanews\",\"indices\":[126,149],\"url\":\"https://t.co/JCBSoWBuSH\"}]},\"url\":{\"urls\":[{\"display_url\":\"t.me/sotaproject\",\"expanded_url\":\"https://t.me/sotaproject\",\"indices\":[0,23],\"url\":\"https://t.co/ygcizj0jWn\"}]}}},\"profile_description_language\":\"ru\",\"profile_image_shape\":\"Circle\",\"profile_metadata\":{\"profile_interstitial_type\":\"\"},\"profile_translation\":{\"translator_type\":\"none\"},\"relationship_counts\":{\"followers\":8371,\"following\":156},\"relationship_perspectives\":{\"blocked_by\":false,\"blocking\":false,\"followed_by\":false,\"following\":false,\"live_following\":false,\"muting\":false},\"rest_id\":\"1542541675842732032\",\"super_follow_eligible\":false,\"super_followed_by\":false,\"super_following\":false,\"tweet_counts\":{\"media_tweets\":19628,\"tweets\":30464},\"verification\":{\"verified\":false},\"website\":{\"url\":\"https://t.co/ygcizj0jWn\"}}}},\"edit_control\":{\"edit_tweet_ids\":[\"2105017947240464485\"],\"editable_until_msecs\":\"1790713962000\",\"edits_remaining\":\"5\",\"is_edit_eligible\":true},\"grok_analysis_button\":true,\"grok_annotations\":{\"is_image_editable_by_grok\":false},\"grok_translated_post_with_availability\":{\"data\":{\"associated_data\":{},\"destination_language\":\"en\",\"entities\":{\"hashtags\":[],\"symbols\":[],\"urls\":[],\"user_mentions\":[]},\"preview_translation\":\"After Footballer's Recommendation, Tolstoy's Book Becomes Amazon Bestseller in Brazil\\n\\n⠀\\nLeo Tolstoy's novella *The Death of Ivan Ilyich* topped sales on Amazon Brasil following a recommendation from Atlético midfielder Gustavo Scarpa, reports G1. The book tells the story of a\",\"source_language\":\"ru\",\"translation\":\"After Footballer's Recommendation, Tolstoy's Book Becomes Amazon Bestseller in Brazil\\n\\n⠀\\nLeo Tolstoy's novella *The Death of Ivan Ilyich* topped sales on Amazon Brasil following a recommendation from Atlético midfielder Gustavo Scarpa, reports G1. The book tells the story of a civil servant who, after a serious illness, realizes the proximity of death and reevaluates his life.\\n\\n⠀\\nSince late August, Scarpa has been posting user_24e6654b reviews of books he's read. His video on Tolstoy's novella garnered over 565,000 views in two weeks.\\n\\n⠀\\nThe footballer's recommendation also inspired fans to create the Galeitura book club. It already has around 500 members who read and discuss selected books together.\\n\\nScreenshot: Amazon\"},\"is_available\":true},\"is_translatable\":false,\"legacy\":{\"bookmark_count\":0,\"bookmarked\":false,\"conversation_id_str\":\"2105017947240464485\",\"created_at\":\"Tue Sep 29 19:32:42 +0000 2026\",\"display_text_range\":[0,270],\"entities\":{\"media\":[{\"allow_download_status\":{\"allow_download\":true},\"display_url\":\"pic.x.com/uIIdKBgZAM\",\"expanded_url\":\"https://x.com/sotaproject/status/2105017947240464485/photo/1\",\"ext_media_availability\":{\"status\":\"Available\"},\"features\":{\"large\":{\"faces\":[]},\"medium\":{\"faces\":[]},\"orig\":{\"faces\":[]},\"small\":{\"faces\":[]}},\"id_str\":\"2105017941066416128\",\"indices\":[271,294],\"media_key\":\"3_2105017941066416128\",\"media_results\":{\"result\":{\"media_key\":\"3_2105017941066416128\"}},\"media_url_https\":\"https://pbs.twimg.com/media/HTaGqh8WgAAPTMX.jpg\",\"original_info\":{\"focus_rects\":[{\"h\":894,\"w\":1596,\"x\":0,\"y\":0},{\"h\":894,\"w\":894,\"x\":0,\"y\":0},{\"h\":894,\"w\":784,\"x\":0,\"y\":0},{\"h\":894,\"w\":447,\"x\":134,\"y\":0},{\"h\":894,\"w\":2048,\"x\":0,\"y\":0}],\"height\":894,\"width\":2048},\"sizes\":{\"large\":{\"h\":894,\"resize\":\"fit\",\"w\":2048},\"medium\":{\"h\":524,\"resize\":\"fit\",\"w\":1200},\"small\":{\"h\":297,\"resize\":\"fit\",\"w\":680},\"thumb\":{\"h\":150,\"resize\":\"crop\",\"w\":150}},\"type\":\"photo\",\"url\":\"https://t.co/uIIdKBgZAM\"}]},\"extended_entities\":{\"media\":[{\"allow_download_status\":{\"allow_download\":true},\"display_url\":\"pic.x.com/uIIdKBgZAM\",\"expanded_url\":\"https://x.com/sotaproject/status/2105017947240464485/photo/1\",\"ext_media_availability\":{\"status\":\"Available\"},\"features\":{\"large\":{\"faces\":[]},\"medium\":{\"faces\":[]},\"orig\":{\"faces\":[]},\"small\":{\"faces\":[]}},\"id_str\":\"2105017941066416128\",\"indices\":[271,294],\"media_key\":\"3_2105017941066416128\",\"media_results\":{\"result\":{\"media_key\":\"3_2105017941066416128\"}},\"media_url_https\":\"https://pbs.twimg.com/media/HTaGqh8WgAAPTMX.jpg\",\"original_info\":{\"focus_rects\":[{\"h\":894,\"w\":1596,\"x\":0,\"y\":0},{\"h\":894,\"w\":894,\"x\":0,\"y\":0},{\"h\":894,\"w\":784,\"x\":0,\"y\":0},{\"h\":894,\"w\":447,\"x\":134,\"y\":0},{\"h\":894,\"w\":2048,\"x\":0,\"y\":0}],\"height\":894,\"width\":2048},\"sizes\":{\"large\":{\"h\":894,\"resize\":\"fit\",\"w\":2048},\"medium\":{\"h\":524,\"resize\":\"fit\",\"w\":1200},\"small\":{\"h\":297,\"resize\":\"fit\",\"w\":680},\"thumb\":{\"h\":150,\"resize\":\"crop\",\"w\":150}},\"type\":\"photo\",\"url\":\"https://t.co/uIIdKBgZAM\"}]},\"favorite_count\":3,\"favorited\":false,\"full_text\":\"Post text removed by scrub-recordings.\",\"id_str\":\"2105017947240464485\",\"is_quote_status\":false,\"lang\":\"ru\",\"possibly_sensitive\":false,\"possibly_sensitive_editable\":true,\"quote_count\":0,\"reply_count\":1,\"retweet_count\":1,\"retweeted\":false,\"user_id_str\":\"1542541675842732032\"},\"note_tweet\":{\"is_expandable\":true,\"note_tweet_results\":{\"result\":{\"entity_set\":{\"hashtags\":[],\"smarttags\":[],\"symbols\":[],\"timestamps\":[],\"urls\":[],\"user_mentions\":[]},\"id\":\"Tm90ZVR3ZWV0OjIxMDUwMTc5NDcxMzU1NDEyNDg=\",\"text\":\"После рекомендации футболиста книга Толстого стала бестселлером Amazon в Бразилии\\n⠀\\nПовесть Льва Толстого «Смерть Ивана Ильича» заняла первое место по продажам на Amazon Brasil после рекомендации полузащитника «Атлетико» Густаво Скарпы, сообщает G1. Книга рассказывает о чиновнике, который после тяжёлой болезни осознаёт близость смерти и переосмысливает свою жизнь.\\n⠀\\nС конца августа Скарпа публикует на user_24e6654b обзоры прочитанных книг. Его ролик о повести Толстого за две недели набрал более 565 тысяч просмотров.\\n⠀\\nРекомендация футболиста также вдохновила болельщиков на создание книжного клуба Galeitura. В нём уже около 500 участников, которые вместе читают и обсуждают выбранные книги.\\n\\nСкриншот: Amazon\"}}},\"quick_promote_eligibility\":{\"eligibility\":\"IneligibleNotVerified\"},\"rest_id\":\"2105017947240464485\",\"source\":\"<a href=\\\"http://twitter.com/download/iphone\\\" rel=\\\"nofollow\\\">Twitter for iPhone</a>\",\"unmention_data\":{},\"views\":{\"count\":\"590\",\"state\":\"EnabledWithCount\"}}}}},\"entryId\":\"tweet-2105017947240464485\",\"sortIndex\":\"2105310577139122157\"},{\"content\":{\"__typename\":\"TimelineTimelineItem\",\"clientEventInfo\":{\"component\":\"organic_tweets\",\"element\":\"tweet\"},\"entryType\":\"TimelineTimelineItem\",\"itemContent\":{\"__typename\":\"TimelineTweet\",\"itemType\":\"TimelineTweet\",\"tweetDisplayType\":\"Tweet\",\"tweet_results\":{\"result\":{\"__typename\":\"Tweet\",\"cashtag_attachments\":[],\"core\":{\"user_results\":{\"result\":{\"__typename\":\"User\",\"action_counts\":{\"favorites_count\":135},\"affiliates_highlighted_label\":{},\"avatar\":{\"image_url\":\"https://abs.twimg.com/sticky/default_profile_images/default_profile_normal.png\"},\"banner\":{\"image_url\":\"https://abs.twimg.com/sticky/default_profile_images/default_profile_normal.png\"},\"core\":{\"created_at\":\"Thu Jun 30 16:13:32 +0000 2022\",\"name\":\"SOTA\",\"screen_name\":\"sotaproject\"},\"follow_request_sent\":false,\"has_graduated_access\":true,\"id\":\"VXNlcjoxNTQyNTQxNjc1ODQyNzMyMDMy\",\"is_blue_verified\":true,\"location\":{\"location\":\"\"},\"media_permissions\":{\"can_media_tag\":true},\"notifications_settings\":{\"notifications_enabled\":false},\"parody_commentary_fan_label\":\"None\",\"pinned_items\":{},\"possibly_sensitive\":false,\"privacy\":{\"protected\":false},\"professional\":{\"category\":[{\"icon_name\":\"IconBriefcaseStroke\",\"id\":580,\"name\":\"Media & News Company\"}],\"professional_type\":\"Business\",\"rest_id\":\"1542542586447106049\"},\"profile_bio\":{\"description\":\"Наверное, лучшее российское СМИ.\\nПочта редакции: mail@sotaproject.com\\ntelegram: https://t.co/A8MN1X46oo\\nАнглоязычный твиттер: https://t.co/JCBSoWBuSH\",\"entities\":{\"description\":{\"urls\":[{\"display_url\":\"t.me/sotaproject\",\"expanded_url\":\"http://t.me/sotaproject\",\"indices\":[80,103],\"url\":\"https://t.co/A8MN1X46oo\"},{\"display_url\":\"twitter.com/sotanews\",\"expanded_url\":\"https://twitter.com/sotanews\",\"indices\":[126,149],\"url\":\"https://t.co/JCBSoWBuSH\"}]},\"url\":{\"urls\":[{\"display_url\":\"t.me/sotaproject\",\"expanded_url\":\"https://t.me/sotaproject\",\"indices\":[0,23],\"url\":\"https://t.co/ygcizj0jWn\"}]}}},\"profile_description_language\":\"ru\",\"profile_image_shape\":\"Circle\",\"profile_metadata\":{\"profile_interstitial_type\":\"\"},\"profile_translation\":{\"translator_type\":\"none\"},\"relationship_counts\":{\"followers\":8371,\"following\":156},\"relationship_perspectives\":{\"blocked_by\":false,\"blocking\":false,\"followed_by\":false,\"following\":false,\"live_following\":false,\"muting\":false},\"rest_id\":\"1542541675842732032\",\"super_follow_eligible\":false,\"super_followed_by\":false,\"super_following\":false,\"tweet_counts\":{\"media_tweets\":19628,\"tweets\":30464},\"verification\":{\"verified\":false},\"website\":{\"url\":\"https://t.co/ygcizj0jWn\"}}}},\"edit_control\":{\"edit_tweet_ids\":[\"2105009244374483368\"],\"editable_until_msecs\":\"1790711887000\",\"edits_remaining\":\"5\",\"is_edit_eligible\":true},\"grok_analysis_button\":true,\"grok_annotations\":{\"is_image_editable_by_grok\":false},\"grok_translated_post_with_availability\":{\"data\":{\"associated_data\":{},\"destination_language\":\"en\",\"entities\":{\"hashtags\":[],\"symbols\":[],\"urls\":[],\"user_mentions\":[]},\"preview_translation\":\"Kynev was subjected to torture to force a confession of treason – Shulman.\\n\\nAccording to political scientist Ekaterina Shulman's data, during the detention of her colleague Alexander Kynev, FSB officers not only broke his leg in two places but also tortured him with electric\",\"source_language\":\"ru\",\"translation\":\"Kynev was subjected to torture to force a confession of treason – Shulman.\\n\\nAccording to political scientist Ekaterina Shulman's data, during the detention of her colleague Alexander Kynev, FSB officers not only broke his leg in two places but also tortured him with electric shocks in an attempt to force him to confess to treason. After that failed, he was charged with attempted drug trafficking.\"},\"is_available\":true},\"is_translatable\":true,\"legacy\":{\"bookmark_count\":13,\"bookmarked\":false,\"conversation_id_str\":\"2105009244374483368\",\"created_at\":\"Tue Sep 29 18:58:07 +0000 2026\",\"display_text_range\":[0,277],\"entities\":{\"media\":[{\"additional_media_info\":{\"monetizable\":false},\"allow_download_status\":{\"allow_download\":true},\"display_url\":\"pic.x.com/veoFjcMMBE\",\"expanded_url\":\"https://x.com/sotaproject/status/2105009244374483368/video/1\",\"ext_media_availability\":{\"status\":\"Available\"},\"id_str\":\"2105009183388995584\",\"indices\":[278,301],\"media_key\":\"13_2105009183388995584\",\"media_results\":{\"result\":{\"media_key\":\"13_2105009183388995584\"}},\"media_url_https\":\"https://pbs.twimg.com/amplify_video_thumb/2105009183388995584/img/cHfdwcrzWx0XL65W.jpg\",\"original_info\":{\"focus_rects\":[],\"height\":720,\"width\":1280},\"sizes\":{\"large\":{\"h\":720,\"resize\":\"fit\",\"w\":1280},\"medium\":{\"h\":675,\"resize\":\"fit\",\"w\":1200},\"small\":{\"h\":383,\"resize\":\"fit\",\"w\":680},\"thumb\":{\"h\":150,\"resize\":\"crop\",\"w\":150}},\"type\":\"video\",\"url\":\"https://t.co/veoFjcMMBE\",\"video_info\":{\"aspect_ratio\":[16,9],\"duration_millis\":40633,\"variants\":[{\"content_type\":\"application/x-mpegURL\",\"url\":\"https://video.twimg.com/amplify_video/2105009183388995584/pl/Ktm7OiCyhaMI-6DU.m3u8?tag=29&v=189\"},{\"bitrate\":256000,\"content_type\":\"video/mp4\",\"url\":\"https://video.twimg.com/amplify_video/2105009183388995584/vid/avc1/480x270/viKKWqlG05pqGUWt.mp4?tag=29\"},{\"bitrate\":832000,\"content_type\":\"video/mp4\",\"url\":\"https://video.twimg.com/amplify_video/2105009183388995584/vid/avc1/640x360/gfXIdwkcXO3xn2J2.mp4?tag=29\"},{\"bitrate\":2176000,\"content_type\":\"video/mp4\",\"url\":\"https://video.twimg.com/amplify_video/2105009183388995584/vid/avc1/1280x720/VhlwJ1oFiul_tf7g.mp4?tag=29\"}]}}]},\"extended_entities\":{\"media\":[{\"additional_media_info
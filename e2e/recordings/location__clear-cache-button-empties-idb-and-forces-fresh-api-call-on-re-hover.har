{\"is_expandable\":true,\"note_tweet_results\":{\"result\":{\"entity_set\":{\"hashtags\":[],\"smarttags\":[],\"symbols\":[],\"timestamps\":[],\"urls\":[],\"user_mentions\":[]},\"id\":\"Tm90ZVR3ZWV0OjIxMDUwMDkyNDQyODYzNjE2MDA=\",\"richtext\":{\"richtext_tags\":[]},\"text\":\"Кынева пытками пытались заставить признаться в госизмене – Шульман.\\n\\nПо данным политологини Екатерины Шульман, при задержании ее коллеге Александру Кыневу сотрудники ФСБ не только сломали ногу в двух местах, но и пытали его током с целью заставить признаться в госизмене. После того, как это не удалось, его обвинили в попытке сбыта наркотиков.\"}}},\"quick_promote_eligibility\":{\"eligibility\":\"IneligibleNotVerified\"},\"rest_id\":\"2105009244374483368\",\"source\":\"<a href=\\\"https://mobile.twitter.com\\\" rel=\\\"nofollow\\\">Twitter Web App</a>\",\"unmention_data\":{},\"views\":{\"count\":\"22872\",\"state\":\"EnabledWithCount\"}}}}},\"entryId\":\"tweet-2105009244374483368\",\"sortIndex\":\"2105310577139122156\"},{\"content\":{\"__typename\":\"TimelineTimelineCursor\",\"cursorType\":\"Top\",\"entryType\":\"TimelineTimelineCursor\",\"value\":\"DAAHCgABHTeQ0MRAJxELAAIAAAATMjEwNTMxMDQyODgwNDgyOTM4MggAAwAAAAEAAA\"},\"entryId\":\"cursor-top-2105310577139122177\",\"sortIndex\":\"2105310577139122177\"},{\"content\":{\"__typename\":\"TimelineTimelineCursor\",\"cursorType\":\"Bottom\",\"entryType\":\"TimelineTimelineCursor\",\"value\":\"DAAHCgABHTeQ0MQ__-kLAAIAAAATMjEwNTAwOTI0NDM3NDQ4MzM2NwgAAwAAAAIAAA\"},\"entryId\":\"cursor-bottom-2105310577139122155\",\"sortIndex\":\"2105310577139122155\"}],\"type\":\"TimelineAddEntries\"}],\"metadata\":{\"scribeConfig\":{\"page\":\"profileOriginals\"}}}}}}}}"},"headersSize":-1,"bodySize":-1,"redirectURL":""},"cache":{},"timings":{"send":-1,"wait":-1,"receive":42.363}},{"startedDateTime":"2026-09-30T14:55:30.480Z","time":5.734,"request":{"method":"GET","url":"https://abs.twimg.com/emoji/v2/svg/1f3f3-fe0f-200d-1f308.svg","httpVersion":"HTTP/2.0","cookies":[],"
request_sent\":false,\"has_graduated_access\":true,\"id\":\"VXNlcjoxNTQyNTQxNjc1ODQyNzMyMDMy\",\"is_blue_verified\":true,\"location\":{\"location\":\"\"},\"media_permissions\":{\"can_media_tag\":true},\"notifications_settings\":{\"notifications_enabled\":false},\"parody_commentary_fan_label\":\"None\",\"pinned_items\":{},\"possibly_sensitive\":false,\"privacy\":{\"protected\":false},\"professional\":{\"category\":[{\"icon_name\":\"IconBriefcaseStroke\",\"id\":580,\"name\":\"Media & News Company\"}],\"professional_type\":\"Business\",\"rest_id\":\"1542542586447106049\"},\"profile_bio\":{\"description\":\"Наверное, лучшее российское СМИ.\\nПочта редакции: mail@sotaproject.com\\ntelegram: https://t.co/A8MN1X46oo\\nАнглоязычный твиттер: https://t.co/JCBSoWBuSH\",\"entities\":{\"description\":{\"urls\":[{\"display_url\":\"t.me/sotaproject\",\"expanded_url\":\"http://t.me/sotaproject\",\"indices\":[80,103],\"url\":\"https://t.co/A8MN1X46oo\"},{\"display_url\":\"twitter.com/sotanews\",\"expanded_url\":\"https://twitter.com/sotanews\",\"indices\":[126,149],\"url\":\"https://t.co/JCBSoWBuSH\"}]},\"url\":{\"urls\":[{\"display_url\":\"t.me/sotaproject\",\"expanded_url\":\"https://t.me/sotaproject\",\"indices\":[0,23],\"url\":\"https://t.co/ygcizj0jWn\"}]}}},\"profile_description_language\":\"ru\",\"profile_image_shape\":\"Circle\",\"profile_metadata\":{\"profile_interstitial_type\":\"\"},\"profile_translation\":{\"translator_type\":\"none\"},\"relationship_counts\":{\"followers\":8371,\"following\":156},\"relationship_perspectives\":{\"blocked_by\":false,\"blocking\":false,\"followed_by\":false,\"following\":false,\"live_following\":false,\"muting\":false},\"rest_id\":\"1542541675842732032\",\"super_follow_eligible\":false,\"super_followed_by\":false,\"super_following\":false,\"tweet_counts\":{\"media_tweets\":19628,\"tweets\":30464},\"verification\":{\"verified\":false},\"website\":{\"url\":\"https://t.co/ygcizj0jWn\"}}}},\"edit_control\":{\"edit_tweet_ids\":[\"2105310428804829382\"],\"editable_until_msecs\":\"1790783695000\",\"edits_remaining\":\"5\",\"is_edit_eligible\":true},\"grok_analysis_button\":true,\"grok_annotations\":{},\"grok_translated_post_with_availability\":{\"is_available\":false},\"is_translatable\":true,\"legacy\":{\"bookmark_count\":0,\"bookmarked\":false,\"conversation_id_str\":\"2105310428804829382\",\"created_at\":\"Wed Sep 30 14:54:55 +0000 2026\",\"display_text_range\":[0,270],\"entities\":{},\"favorite_count\":0,\"favorited\":false,\"full_text\":\"Post text removed by scrub-recordings.\",\"id_str\":\"2105310428804829382\",\"is_quote_status\":false,\"lang\":\"ru\",\"quote_count\":0,\"reply_count\":0,\"retweet_count\":0,\"retweeted\":false,\"user_id_str\":\"1542541675842732032\"},\"note_tweet\":{\"is_expandable\":true,\"note_tweet_results\":{\"result\":{\"entity_set\":{\"hashtags\":[],\"smarttags\":[],\"symbols\":[],\"urls\":[],\"user_mentions\":[]},\"id\":\"Tm90ZVR3ZWV0OjIxMDUzMTA0Mjg2NzQ4OTU4NzI=\",\"richtext\":{\"richtext_tags\":[{\"from_index\":0,\"richtext_types\":[\"Bold\"],\"to_index\":63}]},\"text\":\"В колонии под Петербургом решили сжечь книги зарубежных авторов\\n\\nОб этом пишет «Фонтанка» со ссылкой на своего читателя.\\n\\nПо его словам, в ИК-6 в поселке Обухово у заключенных забрали всю литературу зарубежных авторов, причем изъяли как книги из библиотеки, так и личные экземпляры осужденных. Он утверждает, что книги собираются уничтожить в печи, а заключенным разрешили оставить только Библию и русскую классику.\\n\\nВ управлении ФСИН по Петербургу и Ленинградской области заявили, что в колонии проходит ежемесячная проверка библиотечных фондов и личных книг заключенных. Во время нее сотрудники проверяют, нет ли среди литературы изданий из списка экстремистских материалов, а также книг, которые пропагандируют насилие и криминальную субкультуру или содержат инструкции по изготовлению запрещенных предметов и веществ.\\n\\nВо ФСИН при этом отрицают, что книги зарубежных авторов собираются уничтожать. В ведомстве утверждают, что не запрещенную литературу, которая не прошла проверку, заключенные могут передать родственникам или оставить на хранение до освобождения, а уничтожению подлежат только ветхие библиотечные экземпляры и книги из списка экстремистских материалов.\"}}},\"quick_promote_eligibility\":{\"eligibility\":\"IneligibleNotVerified\"},\"rest_id\":\"2105310428804829382\",\"source\":\"<a href=\\\"https://mobile.twitter.com\\\" rel=\\\"nofollow\\\">Twitter Web App</a>\",\"unmention_data\":{},\"views\":{\"count\":\"9\",\"state\":\"EnabledWithCount\"}}}}},\"entryId\":\"tweet-2105310428804829382\",\"sortIndex\":\"2105310577139122176\"},{\"content\":{\"__typename\":\"TimelineTimelineItem\",\"clientEventInfo\":{\"component\":\"organic_tweets\",\"element\":\"tweet\"},\"entryType\":\"TimelineTimelineItem\",\"itemContent\":{\"__typename\":\"TimelineTweet\",\"itemType\":\"TimelineTweet\",\"tweetDisplayType\":\"Tweet\",\"tweet_results\":{\"result\":{\"__typename\":\"Tweet\",\"cashtag_attachments\":[],\"core\":{\"user_results\":{\"result\":{\"__typename\":\"User\",\"action_counts\":{\"favorites_count\":135},\"affiliates_highlighted_label\":{},\"avatar\":{\"image_url\":\"https://abs.twimg.com/sticky/default_profile_images/default_profile_normal.png\"},\"banner\":{\"image_url\":\"https://abs.twimg.com/sticky/default_profile_images/default_profile_normal.png\"},\"core\":{\"created_at\":\"Thu Jun 30 16:13:32 +0000 2022\",\"name\":\"SOTA\",\"screen_name\":\"sotaproject\"},\"follow_request_sent\":false,\"has_graduated_access\":true,\"id\":\"VXNlcjoxNTQyNTQxNjc1ODQyNzMyMDMy\",\"is_blue_verified\":true,\"location\":{\"location\":\"\"},\"media_permissions\":{\"can_media_tag\":true},\"notifications_settings\":{\"notifications_enabled\":false},\"parody_commentary_fan_label\":\"None\",\"pinned_items\":{},\"possibly_sensitive\":false,\"privacy\":{\"protected\":false},\"professional\":{\"category\":[{\"icon_name\":\"IconBriefcaseStroke\",\"id\":580,\"name\":\"Media & News Company\"}],\"professional_type\":\"Business\",\"rest_id\":\"1542542586447106049\"},\"profile_bio\":{\"description\":\"Наверное, лучшее российское СМИ.\\nПочта редакции: mail@sotaproject.com\\ntelegram: https://t.co/A8MN1X46oo\\nАнглоязычный твиттер: https://t.co/JCBSoWBuSH\",\"entities\":{\"description\":{\"urls\":[{\"display_url\":\"t.me/sotaproject\",\"expanded_url\":\"http://t.me/sotaproject\",\"indices\":[80,103],\"url\":\"https://t.co/A8MN1X46oo\"},{\"display_url\":\"twitter.com/sotanews\",\"expanded_url\":\"https://twitter.com/sotanews\",\"indices\":[126,149],\"url\":\"https://t.co/JCBSoWBuSH\"}]},\"url\":{\"urls\":[{\"display_url\":\"t.me/sotaproject\",\"expanded_url\":\"https://t.me/sotaproject\",\"indices\":[0,23],\"url\":\"https://t.co/ygcizj0jWn\"}]}}},\"profile_description_language\":\"ru\",\"profile_image_shape\":\"Circle\",\"profile_metadata\":{\"profile_interstitial_type\":\"\"},\"profile_translation\":{\"translator_type\":\"none\"},\"relationship_counts\":{\"followers\":8371,\"following\":156},\"relationship_perspectives\":{\"blocked_by\":false,\"blocking\":false,\"followed_by\":false,\"following\":false,\"live_following\":false,\"muting\":false},\"rest_id\":\"1542541675842732032\",\"super_follow_eligible\":false,\"super_followed_by\":false,\"super_following\":false,\"tweet_counts\":{\"media_tweets\":19628,\"tweets\":30464},\"verification\":{\"verified\":false},\"website\":{\"url\":\"https://t.co/ygcizj0jWn\"}}}},\"edit_control\":{\"edit_tweet_ids\":[\"2105296402322530351\"],\"editable_until_msecs\":\"1790780351000\",\"edits_remaining\":\"5\",\"is_edit_eligible\":true},\"grok_analysis_button\":true,\"grok_annotations\":{},\"grok_translated_post_with_availability\":{\"is_available\":false},\"is_translatable\":true,\"legacy\":{\"bookmark_count\":0,\"bookmarked\":false,\"conversation_id_str\":\"2105296402322530351\",\"created_at\":\"Wed Sep 30 13:59:11 +0000 2026\",\"display_text_range\":[0,277],\"entities\":{},\"favorite_count\":1,\"favorited\":false,\"full_text\":\"Post text removed by scrub-recordings.\",\"id_str\":\"2105296402322530351\",\"is_quote_status\":false,\"lang\":\"ru\",\"quote_count\":0,\"reply_count\":0,\"retweet_count\":0,\"retweeted\":false,\"user_id_str\":\"1542541675842732032\"},\"note_tweet\":{\"is_expandable\":true,\"note_tweet_results\":{\"result\":{\"entity_set\":{\"hashtags\":[],\"smarttags\":[],\"symbols\":[],\"urls\":[],\"user_mentions\":[]},\"id\":\"Tm90ZVR3ZWV0OjIxMDUyOTY0MDIyMjU5NzkzOTI=\",\"richtext\":{\"richtext_tags\":[{\"from_index\":0,\"richtext_types\":[\"Bold\"],\"to_index\":87}]},\"text\":\"Россия и пять стран СНГ договорились обмениваться данными об экстремистах и террористах\\n\\nОб этом сообщает РБК.\\n\\nРоссия, Беларусь, Казахстан, Кыргызстан, Таджикистан и Узбекистан будут оперативно передавать друг другу сведения об организациях, группах и отдельных лицах, которых считают террористами или экстремистами, а также об их международных связях. Соглашение распространяется и на информацию о готовящихся терактах, незаконных вооруженных формированиях и действиях, которые власти этих стран расценивают как угрозу государственному суверенитету.\\n\\nКроме того, обмен затронет данные о торговле людьми, оружием и наркотиками, организаторах незаконной миграции, иностранных боевиках и членах их семей. Стороны также намерены сотрудничать при выявлении поддельных удостоверений личности и проездных документов.\"}}},\"quick_promote_eligibility\":{\"eligibility\":\"IneligibleNotVerified\"},\"rest_id\":\"2105296402322530351\",\"source\":\"<a href=\\\"https://mobile.twitter.com\\\" rel=\\\"nofollow\\\">Twitter Web App</a>\",\"unmention_data\":{},\"views\":{\"count\":\"106\",\"state\":\"EnabledWithCount\"}}}}},\"entryId\":\"tweet-2105296402322530351\",\"sortIndex\":\"2105310577139122175\"},{\"content\":{\"__typename\":\"TimelineTimelineItem\",\"clientEventInfo\":{\"component\":\"organic_tweets\",\"element\":\"tweet\"},\"entryType\":\"TimelineTimelineItem\",\"itemContent\":{\"__typename\":\"TimelineTweet\",\"itemType\":\"TimelineTweet\",\"tweetDisplayType\":\"Tweet\",\"tweet_results\":{\"result\":{\"__typename\":\"Tweet\",\"cashtag_attachments\":[],\"core\":{\"user_results\":{\"result\":{\"__typename\":\"User\",\"action_counts\":{\"favorites_count\":135},\"affiliates_highlighted_label\":{},\"avatar\":{\"image_url\":\"https://abs.twimg.com/sticky/default_profile_images/default_profile_normal.png\"},\"banner\":{\"image_url\":\"https://abs.twimg.com/sticky/default_profile_images/default_profile_normal.png\"},\"core\":{\"created_at\":\"Thu Jun 30 16:13:32 +0000 2022\",\"name\":\"SOTA\",\"screen_name\":\"sotaproject\"},\"follow_request_sent\":false,\"has_graduated_access\":true,\"id\":\"VXNlcjoxNTQyNTQxNjc1ODQyNzMyMDMy\",\"is_blue_verified\":true,\"location\":{\"location\":\"\"},\"media_permissions\":{\"can_media_tag\":true},\"notifications_settings\":{\"notifications_enabled\":false},\"parody_commentary_fan_label\":\"None\",\"pinned_items\":{},\"possibly_sensitive\":false,\"privacy\":{\"protected\":false},\"professional\":{\"category\":[{\"icon_name\":\"IconBriefcaseStroke\",\"id\":580,\"name\":\"Media & News Company\"}],\"professional_type\":\"Business\",\"rest_id\":\"1542542586447106049\"},\"profile_bio\":{\"description\":\"Наверное, лучшее российское СМИ.\\nПочта редакции: mail@sotaproject.com\\ntelegram: https://t.co/A8MN1X46oo\\nАнглоязычный твиттер: https://t.co/JCBSoWBuSH\",\"entities\":{\"description\":{\"urls\":[{\"display_url\":\"t.me/sotaproject\",\"expanded_url\":\"http://t.me/sotaproject\",\"indices\":[80,103],\"url\":\"https://t.co/A8MN1X46oo\"},{\"display_url\":\"twitter.com/sotanews\",\"expanded_url\":\"https://twitter.com/sotanews\",\"indices\":[126,149],\"url\":\"https://t.co/JCBSoWBuSH\"}]},\"url\":{\"urls\":[{\"display_url\":\"t.me/sotaproject\",\"expanded_url\":\"https://t.me/sotaproject\",\"indices\":[0,23],\"url\":\"https://t.co/ygcizj0jWn\"}]}}},\"profile_description_language\":\"ru\",\"profile_image_shape\":\"Circle\",\"profile_metadata\":{\"profile_interstitial_type\":\"\"},\"profile_translation\":{\"translator_type\":\"none\"},\"relationship_counts\":{\"followers\":8371,\"following\":156},\"relationship_perspectives\":{\"blocked_by\":false,\"blocking\":false,\"followed_by\":false,\"following\":false,\"live_following\":false,\"muting\":false},\"rest_id\":\"1542541675842732032\",\"super_follow_eligible\":false,\"super_followed_by\":false,\"super_following\":false,\"tweet_counts\":{\"media_tweets\":19628,\"tweets\":30464},\"verification\":{\"verified\":false},\"website\":{\"url\":\"https://t.co/ygcizj0jWn\"}}}},\"edit_control\":{\"edit_tweet_ids\":[\"2105289266871841210\"],\"editable_until_msecs\":\"1790778650000\",\"edits_remaining\":\"5\",\"is_edit_eligible\":true},\"grok_analysis_button\":true,\"grok_annotations\":{},\"grok_translated_post_with_availability\":{\"is_available\":false},\"is_translatable\":true,\"legacy\":{\"bookmark_count\":0,\"bookmarked\":false,\"conversation_id_str\":\"2105289266871841210\",\"created_at\":\"Wed Sep 30 13:30:50 +0000 2026\",\"display_text_range\":[0,280],\"entities\":{},\"favorite_count\":1,\"favorited\":false,\"full_text\":\"Post text removed by scrub-recordings.\",\"id_str\":\"2105289266871841210\",\"is_quote_status\":false,\"lang\":\"ru\",\"quote_count\":0,\"reply_count\":1,\"retweet_count\":1,\"retweeted\":false,\"user_id_str\":\"1542541675842732032\"},\"note_tweet\":{\"is_expandable\":true,\"note_tweet_results\":{\"result\":{\"entity_set\":{\"hashtags\":[],\"smarttags\":[],\"symbols\":[],\"urls\":[],\"user_mentions\":[]},\"id\":\"Tm90ZVR3ZWV0OjIxMDUyODkyNjY3NDYwODUzNzY=\",\"text\":\"С 2027 года во всех российских школах планируют запустить единое телевидение\\n\\nЕдиное школьное телевидение планируют запустить во всех российских школах с 2027 года. Об этом 30 сентября заявил министр просвещения Сергей Кравцов, передает «Интерфакс». До этого проект протестируют в 15 регионах — какие именно субъекты вошли в пилот, министр не уточнил. \\n\\n«В развитии системы воспитательной работы мы создали школьное телевидение, когда будут различные фильмы, ролики, интересные детям, необходимые в том числе для обучения, показываться после уроков, на переменках», — сказал Кравцов. По его словам, после пилотного этапа систему планируют распространить на все школы страны. \\n\\nСогласно сайту проекта «Школьное Телевидение», речь идет о единой федеральной системе, объединяющей школьные экраны в общую сеть. На них планируют транслировать новости, образовательные ролики, материалы Минпросвещения и объявления. Контент будет создавать и модерировать централизованная редакция, а материалы — автоматически поступать на школьные экраны. \\n\\nМинпросвещения сообщало о начале апробации проекта еще в мае 2026 года в Московской области. В ведомстве тогда уточняли, что экраны предполагается размещать в холлах, рекреациях, столовых и зонах ожидания школ.\"}}},\"quick_promote_eligibility\":{\"eligibility\":\"IneligibleNotVerified\"},\"rest_id\":\"2105289266871841210\",\"source\":\"<a href=\\\"http://twitter.com/download/iphone\\\" rel=\\\"nofollow\\\">Twitter for iPhone</a>\",\"unmention_data\":{},\"views\":{\"count\":\"228\",\"state\":\"EnabledWithCount\"}}}}},\"entryId\":\"tweet-2105289266871841210\",\"sortIndex\":\"2105310577139122174\"},{\"content\":{\"__typename\":\"TimelineTimelineItem\",\"clientEventInfo\":{\"component\":\"organic_tweets\",\"element\":\"tweet\"},\"entryType\":\"TimelineTimelineItem\",\"itemContent\":{\"__typename\":\"TimelineTweet\",\"itemType\":\"TimelineTweet\",\"tweetDisplayType\":\"Tweet\",\"tweet_results\":{\"result\":{\"__typename\":\"Tweet\",\"cashtag_attachments\":[],\"core\":{\"user_results\":{\"result\":{\"__typename\":\"User\",\"action_counts\":{\"favorites_count\":135},\"affiliates_highlighted_label\":{},\"avatar\":{\"image_url\":\"https://abs.twimg.com/sticky/default_profile_images/default_profile_normal.png\"},\"banner\":{\"image_url\":\"https://abs.twimg.com/sticky/default_profile_images/default_profile_normal.png\"},\"co
f6f29b17\",function(e){return\"You don’t have access to ad account (ID: \"+e.adAccountId+\"). Ask your team admin to add you to the account in the Ads Manager.\"}),o(\"a15bb840\",\"Need payment method\"),o(\"j4e981d9\",function(e){return\"Your ad account (ID: \"+e.adAccountId+\") is partially set up. To activate it, add a payment method to the account. Any credits you apply to this account will be used up before you’re charged.\"}),o(\"af142910\",\"Payment failed\"),o(\"a9635acf\",function(e){return\"Your ad account (ID: \"+e.adAccountId+\") has been active, but the last payment failed. To activate it again, change the payment method on this account.\"}),o(\"d1cca474\",\"Change payment method\"),o(\"fe8b969a\",\"Customer support can help\"),o(\"i8aa0b91\",function(e){return\"This ad account (ID: \"+e.adAccountId+\") needs help from customer support to activate. Be sure to include the ad account id in your message. Your request will be prioritized.\"}),o(\"ad37d536\",\"Handle Transfer Terms\"),o(\"e760074a\",\"Acquire a dormant handle, or swap one you own\"),o(\"j003ef92\",\"Purchase inactive handles from X for you or your affiliates, or swap handles you already own.\"),o(\"d57a8e42\",\"This service is exclusive to Verified Organizations and involves an additional cost per handle, starting from $10,000 USD.\"),o(\"hef473cc\",\"This service is exclusive to Premium Businesses and involves an additional cost per handle, starting from $10,000 USD.\"),o(\"h9367bd6\",\"Submit a handle inquiry\"),o(\"a6a62e7e\",\"Start the process by answering a few questions using our automated support bot.\"),o(\"e5912290\",\"Handle inquiry starting\"),o(\"c2e24f66\",\"Look out for the support message in the bottom corner of this screen.\"),o(\"c94f514e\",\"Handle inquiry started\"),o(\"cf60d152\",\"Complete the short questionnaire in the chat window to submit your handle inquiry.\"),o(\"f06b124e\",\"Frequently asked questions\"),o(\"h677fdcc\",\"How are handles priced?\"),o(\"a55b39aa\",
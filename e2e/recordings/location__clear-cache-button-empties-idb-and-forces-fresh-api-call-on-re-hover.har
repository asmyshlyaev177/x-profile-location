file_metadata\":{\"profile_interstitial_type\":\"\"},\"profile_translation\":{\"translator_type\":\"none\"},\"relationship_counts\":{\"followers\":8371,\"following\":156},\"relationship_perspectives\":{\"blocked_by\":false,\"blocking\":false,\"followed_by\":false,\"following\":false,\"live_following\":false,\"muting\":false},\"rest_id\":\"1542541675842732032\",\"super_follow_eligible\":false,\"super_followed_by\":false,\"super_following\":false,\"tweet_counts\":{\"media_tweets\":19628,\"tweets\":30464},\"verification\":{\"verified\":false},\"website\":{\"url\":\"https://t.co/ygcizj0jWn\"}}}},\"edit_control\":{\"edit_tweet_ids\":[\"2105248307958198518\"],\"editable_until_msecs\":\"1790768884000\",\"edits_remaining\":\"5\",\"is_edit_eligible\":true},\"grok_analysis_button\":true,\"grok_annotations\":{},\"grok_translated_post_with_availability\":{\"is_available\":false},\"is_translatable\":false,\"legacy\":{\"bookmark_count\":0,\"bookmarked\":false,\"conversation_id_str\":\"2105248307958198518\",\"created_at\":\"Wed Sep 30 10:48:04 +0000 2026\",\"display_text_range\":[0,277],\"entities\":{\"media\":[{\"allow_download_status\":{\"allow_download\":true},\"display_url\":\"pic.x.com/I9wMHRjP0w\",\"expanded_url\":\"https://x.com/sotaproject/status/2105248307958198518/photo/1\",\"ext_media_availability\":{\"status\":\"Available\"},\"features\":{\"large\":{\"faces\":[{\"h\":61,\"w\":61,\"x\":821,\"y\":464},{\"h\":145,\"w\":145,\"x\":835,\"y\":694},{\"h\":207,\"w\":207,\"x\":376,\"y\":408}]},\"medium\":{\"faces\":[{\"h\":61,\"w\":61,\"x\":821,\"y\":464},{\"h\":145,\"w\":145,\"x\":835,\"y\":694},{\"h\":207,\"w\":207,\"x\":376,\"y\":408}]},\"orig\":{\"faces\":[{\"h\":61,\"w\":61,\"x\":821,\"y\":464},{\"h\":145,\"w\":145,\"x\":835,\"y\":694},{\"h\":207,\"w\":207,\"x\":376,\"y\":408}]},\"small\":{\"faces\":[{\"h\":40,\"w\":40,\"x\":545,\"y\":308},{\"h\":96,\"w\":96,\"x\":554,\"y\":460},{\"h\":137,\"w\":137,\"x\":249,\"y\":270}]}},\"id_str\":\"2105248294007889920\",\"indices\":[278,301],\"media_key\":\"3_2105248294007889920\",\"media_results\":{\"result\":{\"media_key\":\"3_2105248294007889920\"}},\"media_url_https\":\"https://pbs.twimg.com/media/HTdYK1hWYAAnf7u.jpg\",\"original_info\":{\"focus_rects\":[{\"h\":573,\"w\":1024,\"x\":0,\"y\":317},{\"h\":890,\"w\":890,\"x\":41,\"y\":0},{\"h\":890,\"w\":781,\"x\":96,\"y\":0},{\"h\":890,\"w\":445,\"x\":264,\"y\":0},{\"h\":890,\"w\":1024,\"x\":0,\"y\":0}],\"height\":890,\"width\":1024},\"sizes\":{\"large\":{\"h\":890,\"resize\":\"fit\",\"w\":1024},\"medium\":{\"h\":890,\"resize\":\"fit\",\"w\":1024},\"small\":{\"h\":591,\"resize\":\"fit\",\"w\":680},\"thumb\":{\"h\":150,\"resize\":\"crop\",\"w\":150}},\"type\":\"photo\",\"url\":\"https://t.co/I9wMHRjP0w\"}]},\"extended_entities\":{\"media\":[{\"allow_download_status\":{\"allow_download\":true},\"display_url\":\"pic.x.com/I9wMHRjP0w\",\"expanded_url\":\"https://x.com/sotaproject/status/2105248307958198518/photo/1\",\"ext_media_availability\":{\"status\":\"Available\"},\"features\":{\"large\":{\"faces\":[{\"h\":61,\"w\":61,\"x\":821,\"y\":464},{\"h\":145,\"w\":145,\"x\":835,\"y\":694},{\"h\":207,\"w\":207,\"x\":376,\"y\":408}]},\"medium\":{\"faces\":[{\"h\":61,\"w\":61,\"x\":821,\"y\":464},{\"h\":145,\"w\":145,\"x\":835,\"y\":694},{\"h\":207,\"w\":207,\"x\":376,\"y\":408}]},\"orig\":{\"faces\":[{\"h\":61,\"w\":61,\"x\":821,\"y\":464},{\"h\":145,\"w\":145,\"x\":835,\"y\":694},{\"h\":207,\"w\":207,\"x\":376,\"y\":408}]},\"small\":{\"faces\":[{\"h\":40,\"w\":40,\"x\":545,\"y\":308},{\"h\":96,\"w\":96,\"x\":554,\"y\":460},{\"h\":137,\"w\":137,\"x\":249,\"y\":270}]}},\"id_str\":\"2105248294007889920\",\"indices\":[278,301],\"media_key\":\"3_2105248294007889920\",\"media_results\":{\"result\":{\"media_key\":\"3_2105248294007889920\"}},\"media_url_https\":\"https://pbs.twimg.com/media/HTdYK1hWYAAnf7u.jpg\",\"original_info\":{\"focus_rects\":[{\"h\":573,\"w\":1024,\"x\":0,\"y\":317},{\"h\":890,\"w\":890,\"x\":41,\"y\":0},{\"h\":890,\"w\":781,\"x\":96,\"y\":0},{\"h\":890,\"w\":445,\"x\":264,\"y\":0},{\"h\":890,\"w\":1024,\"x\":0,\"y\":0}],\"height\":890,\"width\":1024},\"sizes\":{\"large\":{\"h\":890,\"resize\":\"fit\",\"w\":1024},\"medium\":{\"h\":890,\"resize\":\"fit\",\"w\":1024},\"small\":{\"h\":591,\"resize\":\"fit\",\"w\":680},\"thumb\":{\"h\":150,\"resize\":\"crop\",\"w\":150}},\"type\":\"photo\",\"url\":\"https://t.co/I9wMHRjP0w\"}]},\"favorite_count\":0,\"favorited\":false,\"full_text\":\"Post text removed by scrub-recordings.\",\"id_str\":\"2105248307958198518\",\"is_quote_status\":false,\"lang\":\"ru\",\"possibly_sensitive\":false,\"possibly_sensitive_editable\":true,\"quote_count\":0,\"reply_count\":0,\"retweet_count\":0,\"retweeted\":false,\"user_id_str\":\"1542541675842732032\"},\"note_tweet\":{\"is_expandable\":true,\"note_tweet_results\":{\"result\":{\"entity_set\":{\"hashtags\":[],\"smarttags\":[],\"symbols\":[],\"urls\":[],\"user_mentions\":[]},\"id\":\"Tm90ZVR3ZWV0OjIxMDUyNDgzMDc4MTU1NTUwNzI=\",\"richtext\":{\"richtext_tags\":[]},\"text\":\"В Адыгее судят блогера за попытку вступить в «Антивоенный комитет».\\n\\nНа ненадолго появившийся на сайте Майкопского городского суда пресс-релиз обратило внимание издание «Протокол»:\\n\\n«Основанием для обвинения, – говорилось в релизе, – послужили действия гражданина Х., который в сентябре 2026 года, находясь в г. Краснодаре, осознанно вступил в международную неправительственную организацию «Антивоенный комитет России» («АКР»), признанную террористической <…>. В частности, обвиняемый заполнил анкету ассоциированного члена «АКР» и направил её через мессенджер Telegram неустановленному члену организации».\\n\\nПосле огласки консулы «Антивоенного комитета» выпустили заявление о существовании «фейковых телеграм-ботов, которые копируют название, оформление и стиль официального канала». В разговоре с «Сотой» консул Маргарита Кучушева предоставила ссылки на эти боты, пояснив, что намеренно не включала их в сообщение, чтобы люди не попадали в ловушку.\\n\\nПресс-секретарь «Антивоенного комитета», в свою очередь, сообщила «Соте», что блогер из Адыгеи «к нам точно не попадал».\\n\\nСкриншот: фейковый бот «Антивоенного комитета»\"}}},\"quick_promote_eligibility\":{\"eligibility\":\"IneligibleNotVerified\"},\"rest_id\":\"2105248307958198518\",\"source\":\"<a href=\\\"https://mobile.twitter.com\\\" rel=\\\"nofollow\\\">Twitter Web App</a>\",\"unmention_data\":{},\"views\":{\"count\":\"210\",\"state\":\"EnabledWithCount\"}}}}},\"entryId\":\"tweet-2105248307958198518\",\"sortIndex\":\"2105310577139122167\"},{\"content\":{\"__typename\":\"TimelineTimelineItem\",\"clientEventInfo\":{\"component\":\"organic_tweets\",\"element\":\"tweet\"},\"entryType\":\"TimelineTimelineItem\",\"itemContent\":{\"__typename\":\"TimelineTweet\",\"itemType\":\"TimelineTweet\",\"tweetDisplayType\":\"Tweet\",\"tweet_results\":{\"result\":{\"__typename\":\"Tweet\",\"cashtag_attachments\":[],\"core\":{\"user_results\":{\"result\":{\"__typename\":\"User\",\"action_counts\":{\"favorites_count\":135},\"affiliates_highlighted_label\":{},\"avatar\":{\"image_url\":\"https://abs.twimg.com/sticky/default_profile_images/default_profile_normal.png\"},\"banner\":{\"image_url\":\"https://abs.twimg.com/sticky/default_profile_images/default_profile_normal.png\"},\"core\":{\"created_at\":\"Thu Jun 30 16:13:32 +0000 2022\",\"name\":\"SOTA\",\"screen_name\":\"sotaproject\"},\"follow_request_sent\":false,\"has_graduated_access\":true,\"id\":\"VXNlcjoxNTQyNTQxNjc1ODQyNzMyMDMy\",\"is_blue_verified\":true,\"location\":{\"location\":\"\"},\"media_permissions\":{\"can_media_tag\":true},\"notifications_settings\":{\"notifications_enabled\":false},\"parody_commentary_fan_label\":\"None\",\"pinned_items\":{},\"possibly_sensitive\":false,\"privacy\":{\"protected\":false},\"professional\":{\"category\":[{\"icon_name\":\"IconBriefcaseStroke\",\"id\":580,\"name\":\"Media & News Company\"}],\"professional_type\":\"Business\",\"rest_id\":\"1542542586447106049\"},\"profile_bio\":{\"description\":\"Наверное, лучшее российское СМИ.\\nПочта редакции: mail@sotaproject.com\\ntelegram: https://t.co/A8MN1X46oo\\nАнглоязычный твиттер: https://t.co/JCBSoWBuSH\",\"entities\":{\"description\":{\"urls\":[{\"display_url\":\"t.me/sotaproject\",\"expanded_url\":\"http://t.me/sotaproject\",\"indices\":[80,103],\"url\":\"https://t.co/A8MN1X46oo\"},{\"display_url\":\"twitter.com/sotanews\",\"expanded_url\":\"https://twitter.com/sotanews\",\"indices\":[126,149],\"url\":\"https://t.co/JCBSoWBuSH\"}]},\"url\":{\"urls\":[{\"display_url\":\"t.me/sotaproject\",\"expanded_url\":\"https://t.me/sotaproject\",\"indices\":[0,23],\"url\":\"https://t.co/ygcizj0jWn\"}]}}},\"profile_description_language\":\"ru\",\"profile_image_shape\":\"Circle\",\"profile_metadata\":{\"profile_interstitial_type\":\"\"},\"profile_translation\":{\"translator_type\":\"none\"},\"relationship_counts\":{\"followers\":8371,\"following\":156},\"relationship_perspectives\":{\"blocked_by\":false,\"blocking\":false,\"followed_by\":false,\"following\":false,\"live_following\":false,\"muting\":false},\"rest_id\":\"1542541675842732032\",\"super_follow_eligible\":false,\"super_followed_by\":false,\"super_following\":false,\"tweet_counts\":{\"media_tweets\":19628,\"tweets\":30464},\"verification\":{\"verified\":false},\"website\":{\"url\":\"https://t.co/ygcizj0jWn\"}}}},\"edit_control\":{\"edit_tweet_ids\":[\"2105240347722863072\"],\"editable_until_msecs\":\"1790766987000\",\"edits_remaining\":\"5\",\"is_edit_eligible\":true},\"grok_analysis_button\":true,\"grok_annotations\":{\"is_image_editable_by_grok\":true},\"grok_translated_post_with_availability\":{\"data\":{\"associated_data\":{},\"destination_language\":\"en\",\"entities\":{\"hashtags\":[],\"symbols\":[],\"urls\":[],\"user_mentions\":[]},\"preview_translation\":\"Reznik declared Yashin the heir to Navalny, and FBK the \\\"Foundation of Navalny's Traitors.\\\"\\n\\nYashin's party member Maxim Reznik released a lengthy manifesto dedicated to criticizing FBK's strategy following the death of Alexei Navalny.\\n\\nIn Reznik's view, FBK deviates from Alexei\",\"source_language\":\"ru\",\"translation\":\"Reznik declared Yashin the heir to Navalny, and FBK the \\\"Foundation of Navalny's Traitors.\\\"\\n\\nYashin's party member Maxim Reznik released a lengthy manifesto dedicated to criticizing FBK's strategy following the death of Alexei Navalny.\\n\\nIn Reznik's view, FBK deviates from Alexei Navalny's views on three points:\\n\\n🟣 it does not defend the idea of a parliamentary republic (Yulia Navalnaya stated her intention to become president, and the organization quarreled with another advocate of parliamentarism – Mikhail Khodorkovsky);\\n\\n🟣 it shifted the emphasis from Reznik's idea of \\\"Noon Against Putin\\\" (physical protest presence at polling stations) to choosing from pro-Kremlin parties;\\n\\n🟣 it entered into an alliance with \\\"scoundrel,\\\" in Navalny's definition, Maxim Katz.\\n\\nFrom Reznik's perspective, all three points now align not with FBK, but with Ilya Yashin (and a number of other politicians, on whom Reznik, as a member of Yashin's party political council, places less emphasis – in particular, Dmitry Gudkov): \\\"Ilya Yashin is not a former subordinate of Navalny, but an independent politician and his longtime political ally.\\\"\"},\"is_available\":true},\"is_translatable\":false,\"legacy\":{\"bookmark_count\":6,\"bookmarked\":false,\"conversation_id_str\":\"2105240347722863072\",\"created_at\":\"Wed Sep 30 10:16:27 +0000 2026\",\"display_text_range\":[0,278],\"entities\":{\"media\":[{\"allow_download_status\":{\"allow_download\":true},\"display_url\":\"pic.x.com/qXXUBl55Qf\",\"expanded_url\":\"https://x.com/sotaproject/status/2105240347722863072/photo/1\",\"ext_media_availability\":{\"status\":\"Available\"},\"features\":{\"large\":{\"faces\":[{\"h\":308,\"w\":308,\"x\":591,\"y\":141}]},\"medium\":{\"faces\":[{\"h\":288,\"w\":288,\"x\":554,\"y\":132}]},\"orig\":{\"faces\":[{\"h\":308,\"w\":308,\"x\":591,\"y\":141}]},\"small\":{\"faces\":[{\"h\":163,\"w\":163,\"x\":313,\"y\":74}]}},\"id_str\":\"2105240331025317889\",\"indices\":[279,302],\"media_key\":\"3_2105240331025317889\",\"media_results\":{\"result\":{\"media_key\":\"3_2105240331025317889\"}},\"media_url_https\":\"https://pbs.twimg.com/media/HTdQ7VGXAAEgQfh.jpg\",\"original_info\":{\"focus_rects\":[{\"h\":717,\"w\":1280,\"x\":0,\"y\":0},{\"h\":853,\"w\":853,\"x\":374,\"y\":0},{\"h\":853,\"w\":748,\"x\":426,\"y\":0},{\"h\":853,\"w\":427,\"x\":587,\"y\":0},{\"h\":853,\"w\":1280,\"x\":0,\"y\":0}],\"height\":853,\"width\":1280},\"sizes\":{\"large\":{\"h\":853,\"resize\":\"fit\",\"w\":1280},\"medium\":{\"h\":800,\"resize\":\"fit\",\"w\":1200},\"small\":{\"h\":453,\"resize\":\"fit\",\"w\":680},\"thumb\":{\"h\":150,\"resize\":\"crop\",\"w\":150}},\"type\":\"photo\",\"url\":\"https://t.co/qXXUBl55Qf\"}]},\"extended_entities\":{\"media\":[{\"allow_download_status\":{\"allow_download\":true},\"display_url\":\"pic.x.com/qXXUBl55Qf\",\"expanded_url\":\"https://x.com/sotaproject/status/2105240347722863072/photo/1\",\"ext_media_availability\":{\"status\":\"Available\"},\"features\":{\"large\":{\"faces\":[{\"h\":308,\"w\":308,\"x\":591,\"y\":141}]},\"medium\":{\"faces\":[{\"h\":288,\"w\":288,\"x\":554,\"y\":132}]},\"orig\":{\"faces\":[{\"h\":308,\"w\":308,\"x\":591,\"y\":141}]},\"small\":{\"faces\":[{\"h\":163,\"w\":163,\"x\":313,\"y\":74}]}},\"id_str\":\"2105240331025317889\",\"indices\":[279,302],\"media_key\":\"3_2105240331025317889\",\"media_results\":{\"result\":{\"media_key\":\"3_2105240331025317889\"}},\"media_url_https\":\"https://pbs.twimg.com/media/HTdQ7VGXAAEgQfh.jpg\",\"original_info\":{\"focus_rects\":[{\"h\":717,\"w\":1280,\"x\":0,\"y\":0},{\"h\":853,\"w\":853,\"x\":374,\"y\":0},{\"h\":853,\"w\":748,\"x\":426,\"y\":0},{\"h\":853,\"w\":427,\"x\":587,\"y\":0},{\"h\":853,\"w\":1280,\"x\":0,\"y\":0}],\"height\":853,\"width\":1280},\"sizes\":{\"large\":{\"h\":853,\"resize\":\"fit\",\"w\":1280},\"medium\":{\"h\":800,\"resize\":\"fit\",\"w\":1200},\"small\":{\"h\":453,\"resize\":\"fit\",\"w\":680},\"thumb\":{\"h\":150,\"resize\":\"crop\",\"w\":150}},\"type\":\"photo\",\"url\":\"https://t.co/qXXUBl55Qf\"}]},\"favorite_count\":31,\"favorited\":false,\"full_text\":\"Post text removed by scrub-recordings.\",\"id_str\":\"2105240347722863072\",\"is_quote_status\":false,\"lang\":\"ru\",\"possibly_sensitive\":false,\"possibly_sensitive_editable\":true,\"quote_count\":8,\"reply_count\":24,\"retweet_count\":1,\"retweeted\":false,\"user_id_str\":\"1542541675842732032\"},\"note_tweet\":{\"is_expandable\":true,\"note_tweet_results\":{\"result\":{\"entity_set\":{\"hashtags\":[],\"smarttags\":[],\"symbols\":[],\"urls\":[],\"user_mentions\":[]},\"id\":\"Tm90ZVR3ZWV0OjIxMDUyNDAzNDc1ODQ0NDIzNjg=\",\"richtext\":{\"richtext_tags\":[]},\"text\":\"Резник объявил Яшина наследником Навального, а ФБК – «Фондом предателей Навального».\\n\\nЧлен партии Яшина Максим Резник выпустил объемный манифест, посвященный критике стратегии ФБК после смерти Алексея Навального.\\n\\nФБК, по мнению Резника, не следует взглядам Алексея Навального в трех пунктах:\\n\\n🟣 не отстаивает идею парламентской республики (Юлия Навальная заявила о намерении стать президентом, а организация поссорилась с другим сторонником парламентаризма – Михаилом Ходорковским);\\n\\n🟣 сместил акцент с идеи Резника о «Полдне против Путина» (физического протестного присутствия на участках) на выбор из прокремлевских партий;\\n\\n🟣 вошел в союз с «проходимцем», по определению Навального, Максимом Кацем.\\n\\nС точки зрения Резника, всем трем пунктам теперь соответствует не ФБК, а Илья Яшин (и ряд других политиков, на которых Резник, входящий в политсовет партии Яшина, делает меньший акцент – в частности, Дмитрий Гудков): «Илья Яшин — не бывший подчиненный Навального, а самостоятельный политик и его многолетний политический соратник».\"}}},\"quick_promote_eligibility\":{\"eligibility\":\"IneligibleNotVerified\"},\"rest_id\":\"2105240347722863072\",\"source\":\"<a href=\\\"https://mobile.twitter.com\\\" rel=\\\"nofollow\\\">Twitter Web App</a>\",\"unmention_data\":{},\"views\":{\"count\":\"4046\",\"state\":\"EnabledWithCount\"}}}}},\"entryId\":\"tweet-2105240347722863072\",\"sortIndex\":\"2105310577139122166\"},{\"content\":{\"__typename\":\"TimelineTimelineItem\",\"clientEventInfo\":{\"component\":\"organic_tweets\",\"element\":\"tweet\"},\"entryType\":\"TimelineTimelineItem\",\"itemContent\":{\"__typename\":\"TimelineTweet\",\"itemType\":\"TimelineTweet\",\"tweetDisplayType\":\"Tweet\",\"tweet_results\":{\"result\":{\"__typename\":\"Tweet\",\"cashtag_attachments\":[],\"core\":{\"user_results\":{\"result\":{\"__typename\":\"User\",\"action_counts\":{\"favorites_count\":135},\"affiliates_highlighted_label\":{},\"avatar\":{\"image_url\":\"https://abs.twimg.com/sticky/default_profile_images/default_profile_normal.png\"},\"banner\":{\"image_url\":\"https://abs.twimg.com/sticky/default_profile_images/default_profile_normal.png\"},\"core\":{\"created_at\":\"Thu Jun 30 16:13:32 +0000 2022\",\"name\":\"SOTA\",\"screen_name\":\"sotaproject\"},\"follow_request_sent\":false,\"has_graduated_access\":true,\"id\":\"VXNlcjoxNTQyNTQxNjc1ODQyNzMyMDMy\",\"is_blue_verified\":true,\"location\":{\"location\":\"\"},\"media_permissions\":{\"can_media_tag\":true},\"notifications_settings\":{\"notifications_enabled\":false},\"parody_commentary_fan_label\":\"None\",\"pinned_items\":{},\"possibly_sensitive\":false,\"privacy\":{\"protected\":false},\"professional\":{\"category\":[{\"icon_name\":\"IconBriefcaseStroke\",\"id\":580,\"name\":\"Media & News Company\"}],\"professional_type\":\"Business\",\"rest_id\":\"1542542586447106049\"},\"profile_bio\":{\"description\":\"Наверное, лучшее российское СМИ.\\nПочта редакции: mail@sotaproject.com\\ntelegram: https://t.co/A8MN1X46oo\\nАнглоязычный твиттер: https://t.co/JCBSoWBuSH\",\"entities\":{\"description\":{\"urls\":[{\"display_url\":\"t.me/sotaproject\",\"expanded_url\":\"http://t.me/sotaproject\",\"indices\":[80,103],\"url\":\"https://t.co/A8MN1X46oo\"},{\"display_url\":\"twitter.com/sotanews\",\"expanded_url\":\"https://twitter.com/sotanews\",\"indices\":[126,149],\"url\":\"https://t.co/JCBSoWBuSH\"}]},\"url\":{\"urls\":[{\"display_url\":\"t.me/sotaproject\",\"expanded_url\":\"https://t.me/sotaproject\",\"indices\":[0,23],\"url\":\"https://t.co/ygcizj0jWn\"}]}}},\"profile_description_language\":\"ru\",\"profile_image_shape\":\"Circle\",\"profile_metadata\":{\"profile_interstitial_type\":\"\"},\"profile_translation\":{\"translator_type\":\"none\"},\"relationship_counts\":{\"followers\":8371,\"following\":156},\"relationship_perspectives\":{\"blocked_by\":false,\"blocking\":false,\"followed_by\":false,\"following\":false,\"live_following\":false,\"muting\":false},\"rest_id\":\"1542541675842732032\",\"super_follow_eligible\":false,\"super_followed_by\":false,\"super_following\":false,\"tweet_counts\":{\"media_tweets\":19628,\"tweets\":30464},\"verification\":{\"verified\":false},\"website\":{\"url\":\"https://t.co/ygcizj0jWn\"}}}},\"edit_control\":{\"edit_tweet_ids\":[\"2105238932107448624\"],\"editable_until_msecs\":\"1790766649000\",\"edits_remaining\":\"5\",\"is_edit_eligible\":true},\"grok_analysis_button\":true,\"grok_annotations\":{},\"grok_translated_post_with_availability\":{\"is_available\":false},\"is_translatable\":true,\"legacy\":{\"bookmark_count\":0,\"bookmarked\":false,\"conversation_id_str\":\"2105238932107448624\",\"created_at\":\"Wed Sep 30 10:10:49 +0000 2026\",\"display_text_range\":[0,275],\"entities\":{},\"favorite_count\":1,\"favorited\":false,\"full_text\":\"Post text removed by scrub-recordings.\",\"id_str\":\"2105238932107448624\",\"is_quote_status\":false,\"lang\":\"ru\",\"quote_count\":0,\"reply_count\":0,\"retweet_count\":0,\"retweeted\":false,\"user_id_str\":\"1542541675842732032\"},\"note_tweet\":{\"is_expandable\":true,\"note_tweet_results\":{\"result\":{\"entity_set\":{\"hashtags\":[],\"smarttags\":[],\"symbols\":[],\"urls\":[],\"user_mentions\":[]},\"id\":\"Tm90ZVR3ZWV0OjIxMDUyMzg5MzE5NjkwODEzNDQ=\",\"richtext\":{\"richtext_tags\":[{\"from_index\":0,\"richtext_types\":[\"Bold\"],\"to_index\":53}]},\"text\":\"Песков заявил об отсутствии политзаключенных в России\\n\\nПресс-секретарь президента Дмитрий Песков заявил, что Москва и Вашингтон не обсуждали ослабление американских санкций в обмен на освобождение российских политзаключенных.\\n\\n«В такой постановке эта тема не обсуждалась и не могла обсуждаться, потому что мы категорически отрицаем наличие каких-либо политзаключенных и считаем, что подобная постановка вопроса абсолютно неуместна», — сказал Песков.\\n\\nПри этом Песков подтвердил, что российские и американские спецслужбы продолжают контакты по поводу возможных обменов заключенными. Отвечая на уточняющий вопрос, Песков еще раз заявил, что тема смягчения санкций в обмен на освобождение заключенных с США не обсуждается.\\n\\nРанее The Atlantic написал, что президент США Дональд Трамп поддержал предложение своего спецпредставителя Джона Коула ослабить часть санкций против России в обмен на освобождение политзаключенных. Сам Коул рассказал, что рассчитывает использовать подход, который Вашингтон уже применял на переговорах с Беларусью.\"}}},\"quick_promote_eligibility\":{\"eligibility\":\"IneligibleNotVerified\"},\"rest_id\":\"2105238932107448624\",\"source\":\"<a href=\\\"https://mobile.twitter.com\\\" rel=\\\"nofollow\\\">Twitter Web App</a>\",\"unmention_data\":{},\"views\":{\"count\":\"271\",\"state\":\"EnabledWithCount\"}}}}},\"entryId\":\"tweet-2105238932107448624\",\"sortIndex\":\"2105310577139122165\"},{\"content\":{\"__typename\":\"TimelineTimelineItem\",\"clientEventInfo\":{\"component\":\"organic_tweets\",\"element\":\"tweet\"},\"entryType\":\"TimelineTimelineItem\",\"itemContent\":{\"__typename\":\"TimelineTweet\",\"itemType\":\"TimelineTweet\",\"tweetDisplayType\":\"Tweet\",\"tweet_results\":{\"result\":{\"__typename\":\"Tweet\",\"cashtag_attachments\":[],\"core\":{\"user_results\":{\"result\":{\"__typename\":\"User\",\"action_counts\":{\"favorites_count\":135},\"affiliates_highlighted_label\":{},\"avatar\":{\"image_url\":\"https://abs.twimg.com/sticky/default_profile_images/default_profile_normal.png\"},\"banner\":{\"image_url\":\"https://abs.twimg.com/sticky/default_profile_images/default_profile_normal.png\"},\"core\":{\"created_at\":\"Thu Jun 30 16:13:32 +0000 2022\",\"name\":\"SOTA\",\"screen_name\":\"sotaproject\"},\"follow_request_sent\":false,\"has_graduated_access\":true,\"id\":\"VXNlcjoxNTQyNTQxNjc1ODQyNzMyMDMy\",\"is_blue_verified\":true,\"location\":{\"location\":\"\"},\"media_permissions\":{\"can_media_tag\":true},\"notifications_settings\":{\"notifications_enabled\":false},\"parody_commentary_fan_label\":\"None\",\"pinned_items\":{},\"possibly_sensitive\":false,\"privacy\":{\"protected\":false},\"professional\":{\"category\":[{\"icon_name\":\"IconBriefcaseStroke\",\"id\":580,\"name\":\"Media & News Company\"}],\"professional_type\":\"Business\",\"rest_id\":\"1542542586447106049\"},\"profile_bio\":{\"description\":\"Наверное, лучшее российское СМИ.\\nПочта редакции: mail@sotaproject.com\\ntelegram: https://t.co/A8MN1X46oo\\nАнглоязычный твиттер: https://t.co/JCBSoWBuSH\",\"entities\":{\"description\":{\"urls\":[{\"display_url\":\"t.me/sotaproject\",\"expanded_url\":\"http://t.me/sotaproject\",\"indices\":[80,103],\"url\":\"https://t.co/A8MN1X46oo\"},{\"display_url\":\"twitter.com/sotanews\",\"expanded_url\":\"https://twitter.com/sotanews\",\"indices\":[126,149],\"url\":\"https://t.co/JCBSoWBuSH\"}]},\"url\":{\"urls\":[{\"display_url\":\"t.me/sotaproject\",\"expanded_url\":\"https://t.me/sotaproject\",\"indices\":[0,23],\"url\":\"https://t.co/ygcizj0jWn\"}]}}},\"profile_description_language\":\"ru\",\"profile_image_shape\":\"Circle\",\"profile_metadata\":{\"profile_interstitial_type\":\"\"},\"profile_translation\":{\"translator_type\":\"none\"},\"relationship_counts\":{\"followers\":8371,\"following\":156},\"relationship_perspectives\":{\"blocked_by\":false,\"blocking\":false,\"followed_by\":false,\"following\":false,\"live_following\":false,\"muting\":false},\"rest_id\":\"1542541675842732032\",\"super_follow_eligible\":false,\"super_followed_by\":false,\"super_following\":false,\"tweet_counts\":{\"media_tweets\":19628,\"tweets\":30464},\"verification\":{\"verified\":false},\"website\":{\"url\":\"https://t.co/ygcizj0jWn\"}}}},\"edit_control\":{\"edit_tweet_ids\":[\"2105231543543140471\"],\"editable_until_msecs\":\"1790764887000\",\"edits_remaining\":\"5\",\"is_edit_eligible\":true},\"grok_analysis_button\":true,\"grok_annotations\":{},\"grok_translated_post_with_availability\":{\"is_available\":false},\"is_translatable\":true,\"legacy\":{\"bookmark_count\":1,\"bookmarked\":false,\"conversation_id_str\":\"2105231543543140471\",\"created_at\":\"Wed Sep 30 09:41:27 +0000 2026\",\"display_text_range\":[0,278],\"entities\":{},\"favorite_count\":0,\"favorited\":false,\"full_text\":\"Post text removed by scrub-recordings.\",\"id_str\":\"2105231543543140471\",\"is_quote_status\":false,\"lang\":\"ru\",\"quote_count\":0,\"reply_count\":0,\"retweet_count\":0,\"retweeted\":false,\"user_id_str\":\"1542541675842732032\"},\"note_tweet\":{\"is_expandable\":true,\"note_tweet_results\":{\"result\":{\"entity_set\":{\"hashtags\":[],\"smarttags\":[],\"symbols\":[],\"urls\":[],\"user_mentions\":[]},\"id\":\"Tm90ZVR3ZWV0OjIxMDUyMzE1NDMzNzEyODg1NzY=\",\"richtext\":{\"richtext_tags\":[{\"from_index\":0,\"richtext_types\":[\"Bold\"],\"to_index\":60}]},\"text\":\"Фильмы о коррупции среди силовиков могут лишить господдержки\\n\\nОб этом пишет «Коммерсант».\\n\\nПо данным источников газеты, государственное финансирование больше не будут выделять фильмам и сериалам, в которых сотрудники МВД, ФСБ, Следственного комитета или прокуратуры берут взятки или участвуют в преступных схемах. Ограничения также затронут проекты о маньяках и серийных убийцах.\\n\\nНовые требования пока не закреплены в законах или других официальных документах. Источники газеты утверждают, что Минкультуры и Институт развития интернета (ИРИ) устно сообщили о них представителям киноиндустрии. Продюсеры уже знают о новых правилах, а их нарушение может привести к отказу в финансировании следующего проекта.\\n\\nВ Ассоциации продюсеров кино и телевидения заявили, что официальных уведомлений об ограничениях не получали. Минкультуры не ответило на запрос газеты, а Институт развития интернета отказался от комментариев.\\n\\nОдин из продюсеров объяснил возможный отказ от финансирования тем, что негативный образ силовиков «подрывает доверие к государственным институтам». По его словам, в российском кино стало слишком много проектов о 1990-х, в которых сотрудники силовых структур показаны с отрицательной стороны. Он считает, что ограничить господдержку таких фильмов следовало раньше.\\n\\nРанее глава ИРИ Алексей Гореславский говорил, что организация не финансирует сериалы о маньяках, поскольку считает их контентом, который спекулирует на интересе к «запрещенке», психологическим отклонениям и извращениям.\"}}},\"quick_promote_eligibility\":{\"eligibility\":\"IneligibleNotVerified\"},\"rest_id\":\"2105231543543140471\",\"source\":\"<a href=\\\"https://mobile.twitter.com\\\" rel=\\\"nofollow\\\">Twitter Web App</a>\",\"unmention_data\":{},\"views\":{\"count\":\"293\",\"state\":\"EnabledWithCount\"}}}}},\"entryId\":\"tweet-2105231543543140471\",\"sortIndex\":\"2105310577139122164\"},{\"content\":{\"__typename\":\"TimelineTimelineItem\",\"clientEventInfo\":{\"component\":\"organic_tweets\",\"element\":\"tweet\"},\"entryType\":\"TimelineTimelineItem\",\"itemContent\":{\"__typename\":\"TimelineTweet\",\"itemType\":\"TimelineTweet\",\"tweetDisplayType\":\"Tweet\",\"tweet_results\":{\"result\":{\"__typename\":\"Tweet\",\"cashtag_attachments\":[],\"core\":{\"user_results\":{\"result\":{\"__typename\":\"User\",\"action_counts\":{\"favorites_count\":135},\"affiliates_highlighted_label\":{},\"avatar\":{\"image_url\":\"https://abs.twimg.com/sticky/default_profile_images/default_profile_normal.png\"},\"banner\":{\"image_url\":\"https://abs.twimg.com/sticky/default_profile_images/default_profile_normal.png\"},\"core\":{\"created_at\":\"Thu Jun 30 16:13:32 +0000 2022\",\"name\":\"SOTA\",\"screen_name\":\"sotaproject\"},\"follow_request_sent\":false,\"has_graduated_access\":true,\"id\":\"VXNlcjoxNTQyNTQxNjc1ODQyNzMyMDMy\",\"is_blue_verified\":true,\"location\":{\"location\":\"\"},\"media_permissions\":{\"can_media_tag\":true},\"notifications_settings\":{\"notifications_enabled\":false},\"parody_commentary_fan_label\":\"None\",\"pinned_items\":{},\"possibly_sensitive\":false,\"privacy\":{\"protected\":false},\"professional\":{\"category\":[{\"icon_name\":\"IconBriefcaseStroke\",\"id\":580,\"name\":\"Media & News Company\"}],\"professional_type\":\"Business\",\"rest_id\":\"1542542586447106049\"},\"profile_bio\":{\"description\":\"Наверное, лучшее российское СМИ.\\nПочта редакции: mail@sotaproject.com\\ntelegram: https://t.co/A8MN1X46oo\\nАнглоязычный твиттер: https://t.co/JCBSoWBuSH\",\"entities\":{\"description\":{\"urls\":[{\"display_url\":\"t.me/sotaproject\",\"expanded_url\":\"http://t.me/sotaproject\",\"indices\":[80,103],\"url\":\"https://t.co/A8MN1X46oo\"},{\"display_url\":\"twitter.com/sotanews\",\"expanded_url\":\"https://twitter.com/sotanews\",\"indices\":[126,149],\"url\":\"https://t.co/JCBSoWBuSH\"}]},\"url\":{\"urls\":[{\"display_url\":\"t.me/sotaproject\",\"expanded_url\":\"https://t.me/sotaproject\",\"indices\":[0,23],\"url\":\"https://t.co/ygcizj0jWn\"}]}}},\"profile_description_language\":\"ru\",\"profile_image_shape\":\"Circle\",\"profile_metadata\":{\"profile_interstitial_type\":\"\"},\"profile_translation\":{\"translator_type\":\"none\"},\"relationship_counts\":{\"followers\":8371,\"following\":156},\"relationship_perspectives\":{\"blocked_by\":false,\"blocking\":false,\"followed_by\":false,\"following\":false,\"live_following\":false,\"muting\":false},\"rest_id\":\"1542541675842732032\",\"super_follow_eligible\":false,\"super_followed_by\":false,\"super_following\":false,\"tweet_counts\":{\"media_tweets\":19628,\"tweets\":30464},\"verification\":{\"verified\":false},\"website\":{\"url\":\"https://t.co/ygcizj0jWn\"}}}},\"edit_control\":{\"edit_tweet_ids\":[\"2105228399249654157\"],\"editable_until_msecs\":\"1790764138000\",\"edits_remaining\":\"5\",\"is_edit_eligible\":true},\"grok_analysis_button\":true,\"grok_annotations\":{},\"grok_translated_post_with_availability\":{\"data\":{\"associated_data\":{},\"destination_language\":\"en\",\"entities\":{\"hashtags\":[],\"symbols\":[],\"urls\":[],\"user_mentions\":[]},\"preview_translation\":\"The heads of Latvia's Foreign Ministry and Interior Ministry have quarreled over a Russian journalist who does not consider himself one.\\n\\nLatvia's Interior Minister Janis Dombrava stated that \\\"Russian citizen L. Ragozin has for a long period of time publicly expressed opinions\",\"source_language\":\"ru\",\"translation\":\"The heads of Latvia's Foreign Ministry and Interior Ministry have quarreled over a Russian journalist who does not consider himself one.\\n\\nLatvia's Interior Minister Janis Dombrava stated that \\\"Russian citizen L. Ragozin has for a long period of time publicly expressed opinions that directly contradict the interests of the Latvian state\\\" and called on \\\"the foreign minister to include the said individual on the list of undesirable persons for the Republic of Latvia.\\\"\\n\\nThe reason for the proposal to declare journalist Leonid Ragozin persona non grata was that, in Dombrava's view, he had publicly \\\"accused the West of Russia's aggressive actions; spoken about the ineffectiveness of sanctions, believing that they provoke Russia; sought to justify Russia's aggressive foreign policy by questioning that Russia could have imperialist interests in gaining influence in Ukraine and other places; discredited Ukraine, its political leadership, and armed forces.\\\"\\n\\nAt the same time, Dombrava emphasized that there are no grounds for the Interior Ministry to ban Ragozin from entering Latvia.\\n\\nIn response to her colleague's address, Latvia's Foreign Minister Baiba Braze replied: \\\"Given that the Ministry of Interior has issued a residence permit in Latvia to the Russian citizen mentioned by the minister, the decision falls within the competence of the interior minister in accordance with Article 104 of the Immigration Law. The minister is advised not to evade responsibility a few days before the elections.\\\"\\n\\nIt should be noted that Dombrava represents the National Alliance in the government, while Braze represents New Unity. Latvia's Saeima elections will be held on October 3.\\n\\nIt should also be noted that as early as 2019, Ragozin criticized the National Alliance for its ties to Azov, which he considered a neo-Nazi group; later, his criticism also turned to the RDK and Volodymyr Zelenskyy.\\n\\nRagozin emphasized that he does not consider himself a Russian journalist, as he has always worked for Western media: from the BBC to Bloomberg.\"},\"is_available\":true},\"is_translatable\":true,\"legacy\":{\"bookmark_count\":1,\"bookmarked\":false,\"conversation_id_str\":\"2105228399249654157\",\"created_at\":\"Wed Sep 30 09:28:58 +0000 2026\",\"display_text_range\":[0,268],\"entities\":{},\"favorite_count\":0,\"favorited\":false,\"full_text\":\"Post text removed by scrub-recordings.\",\"id_str\":\"2105228399249654157\",\"is_quote_status\":true,\"lang\":\"ru\",\"quote_count\":0,\"quoted_status_id_str\":\"2105220166816592345\",\"quoted_status_permalink\":{\"display\":\"x.com/user_ff148d5e/st…\",\"expanded\":\"https://twitter.com/user_ff148d5e/status/2105220166816592345\",\"url\":\"https://t.co/JLM0z9Jjli\"},\"reply_count\":0,\"retweet_count\":0,\"retweeted\":false,\"user_id_str\":\"1542541675842732032\"},\"note_tweet\":{\"is_expandable\":true,\"note_tweet_results\":{\"result\":{\"entity_set\":{\"hashtags\":[],\"smarttags\":[],\"symbols\":[],\"urls\":[],\"user_mentions\":[]},\"id\":\"Tm90ZVR3ZWV0OjIxMDUyMjgzOTkwNjkyOTA0OTY=\",\"richtext\":{\"richtext_tags\":[]},\"text\":\"Главы МИДа и МВД Латвии поссорились из-за российского журналиста, который себя таковым не считает.\\n\\nМинистр внутренних дел Латвии Янис Домбрава заявил, что «гражданин России Л. Рагозин на протяжении длительного периода времени публично высказывал мнения, которые прямо противоречат интересам латвийского государства» и призвал «министра иностранных дел включить указанное лицо в список нежелательных лиц для Латвийской Республики».\\n\\nПоводом для предложения объявить журналиста Леонида Рагозина персоной нон-грата стало то, что он, по мнению Домбравы, публично «обвинял Запад в агрессивных действиях России;  говорил о неэффективности санкций, считая, что они провоцируют Россию; старался оправдать агрессивную внешнюю политику России, ставя под сомнение, что у России могли бы быть империалистические интересы в приобретении влияния в Украине и других местах;  дискредитировал Украину, ее политическое руководство и вооруженные силы».\\n\\nПри всем этом Домбрава подчеркнул, что поводов для МВД запретить Рагозину въезд в Латвию нет.\\n\\nНа обращение коллеги ответила глава МИДа Латвии Байба Браже: «Учитывая, что Министерство внутренних дел выдало разрешение на пребывание в Латвии гражданину России, упомянутому министром, решение находится в компетенции министра внутренних дел в соответствии со статьёй 104 Закона об иммиграции. Рекомендуется министру не уклоняться от ответственности за несколько дней до выборов».\\n\\nОтметим, что Домбрава в правительстве представляет «Национальное объединение», а Браже – «Новое единство». Выборы Сейма Латвии пройдут 3 октября.\\n\\nОтметим, что Рагозин еще в 2019 году критиковал «Национальное объединение» за связь с «Азовом», который считал неонацистским объединением, позднее его критика переключилась в том числе на РДК и Владимира Зеленского.\\n\\nРагозин подчеркивал, что не считает себя российским журналистом, так как всегда работал на западные СМИ: от BBC до Bloomberg.\"}}},\"quick_promote_eligibility\":{\"eligibility\":\"IneligibleNotVerified\"},\"quoted_status_result\":{\"result\":{\"__typename\":\"Tweet\",\"core\":{\"user_results\":{\"result\":{\"__typename\":\"User\",\"action_counts\":{\"favorites_count\":88183},\"affiliates_highlighted_label\":{},\"avatar\":{\"image_url\":\"https://abs.twimg.com/sticky/default_profile_images/default_profile_normal.png\"},\"banner\":{\"image_url\":\"https://abs.twimg.com/sticky/default_profile_images/default_profile_normal.png\"},\"core\":{\"created_at\":\"Thu Aug 04 11:05:30 +0000 2016\",\"name\":\"User ff14\",\"screen_name\":\"user_ff148d5e\"},\"follow_request_sent\":false,\"has_graduated_access\":true,\"id\":\"VXNlcjo3NjExNTYwOTg0NDc1MTU2NDg=\",\"is_blue_verified\":false,\"location\":{\"location\":\"\"},\"media_permissions\":{\"can_media_tag\":true},\"notifications_settings\":{\"notifications_enabled\":false},\"parody_commentary_fan_label\":\"None\",\"pinned_items\":{\"tweet_ids_str\":[\"1781231823948763257\"]},\"possibly_sensitive\":false,\"privacy\":{\"protected\":false},\"profile_bio\":{\"description\":\"\",\"entities\":{\"description\":{},\"url\":{\"urls\":[]}}},\"profile_image_shape\":\"Circle\",\"profile_metadata\":{\"profile_interstitial_type\":\"\"},\"profile_translation\":{\"translator_type\":\"none\"},\"relationship_counts\":{\"followers\":29233,\"following\":1919},\"relationship_perspectives\":{\"blocked_by\":false,\"blocking\":false,\"followed_by\":false,\"following\":false,\"live_following\":false,\"muting\":false},\"rest_id\":\"761156098447515648\",\"super_follow_eligible\":false,\"super_followed_by\":false,\"super_following\":false,\"tweet_counts\":{\"media_tweets\":2758,\"tweets\":33864},\"verification\":{\"verified\":false,\"verified_type\":\"Government\"},\"website\":{\"url\":\"\"}}}},\"edit_control\":{\"edit_tweet_ids\":[\"2105220166816592345\"],\"editable_until_msecs\":\"1790762175000\",\"edits_remaining\":\"5\",\"is_edit_eligible\":true},\"grok_analysis_button\":true,\"grok_translated_post_with_availability\":{\"data\":{\"associated_data\":{},\"destination_language\":\"en\",\"entities\":{\"hashtags\":[],\"symbols\":[],\"urls\":[],\"user_mentions\":[]},\"preview_translation\":\"Considering that the Ministry of the Interior has issued a residence permit in Latvia to the Russian citizen mentioned by the minister, the decision falls within the competence of the Minister of the Interior pursuant to Article 104 of the Immigration Law. I would recommend that\",\"source_language\":\"lv\",\"translation\":\"Considering that the Ministry of the Interior has issued a residence permit in Latvia to the Russian citizen mentioned by the minister, the decision falls within the competence of the Minister of the Interior pursuant to Article 104 of the Immigration Law. I would recommend that the minister not evade responsibility a few days before the elections.\"},\"is_available\":true},\"is_translatable\":true,\"legacy\":{\"bookmark_count\":12,\"bookmarked\":false,\"conversation_id_str\":\"2105220166816592345\",\"created_at\":\"Wed Sep 30 08:56:15 +0000 2026\",\"display_text_range\":[0,277],\"entities\":{},\"favorite_count\":296,\"favorited\":false,\"full_text\":\"Post text removed by scrub-recordings.\",\"id_str\":\"2105220166816592345\",\"is_quote_status\":true,\"lang\":\"lv\",\"quote_count\":34,\"quoted_status_id_str\":\"2105210639522140301\",\"quoted_status_permalink\":{\"display\":\"x.com/user_080e8f11/…\",\"expanded\":\"https://twitter.com/user_080e8f11/status/2105210639522140301\",\"url\":\"https://t.co/Xy9iPTWdbQ\"},\"reply_count\":54,\"retweet_count\":51,\"retweeted\":false,\"user_id_str\":\"761156098447515648\"},\"nested_quoted_tweet_results\":{\"result\":{\"__typename\":\"Tweet\",\"core\":{\"user_results\":{\"result\":{\"__typename\":\"User\",\"action_counts\":{\"favorites_count\":1770},\"affiliates_highlighted_label\":{},\"avatar\":{\"image_url\":\"https://abs.twimg.com/sticky/default_profile_images/default_profile_normal.png\"},\"banner\":{\"image_url\":\"https://abs.twimg.com/sticky/default_profile_images/default_profile_normal.png\"},\"core\":{\"created_at\":\"Fri Apr 03 21:23:26 +0000 2009\",\"name\":\"User 080e\",\"screen_name\":\"user_080e8f11\"},\"follow_request_sent\":false,\"has_graduated_access\":true,\"id\":\"VXNlcjoyODY1NjU1OA==\",\"is_blue_verified\":true,\"location\":{\"location\":\"\"},\"media_permissions\":{\"can_media_tag\":true},\"notifications_settings\":{\"notifications_enabled\":false},\"parody_commentary_fan_label\":\"None\",\"pinned_items\":{},\"possibly_sensitive\":false,\"privacy\":{\"protected\":false},\"profile_bio\":{\"description\":\"\",\"entities\":{\"description\":{},\"url\":{\"urls\":[]}}},\"profile_description_language\":\"lv\",\"profile_image_shape\":\"Circle\",\"profile_metadata\":{\"profile_interstitial_type\":\"\"},\"profile_translation\":{\"translator_type\":\"none\"},\"relationship_counts\":{\"followers\":7848,\"following\":782},\"relationship_perspectives\":{\"blocked_by\":false,\"blocking\":false,\"followed_by\":false,\"following\":false,\"live_following\":false,\"muting\":false},\"rest_id\":\"28656558\",\"super_follow_eligible\":false,\"super_followed_by\":false,\"super_following\":false,\"tweet_counts\":{\"media_tweets\":681,\"tweets\":6697},\"verification\":{\"verified\":false},\"website\":{\"url\":\"\"}}}},\"edit_control\":{\"edit_tweet_ids\":[\"2105210639522140301\"],\"editable_until_msecs\":\"1790759904000\",\"edits_remaining\":\"5\",\"is_edit_eligible\":true},\"grok_analysis_button\":true,\"grok_translated_post_with_availability\":{\"data\":{\"associated_data\":{},\"destination_language\":\"en\",\"entities\":{\"hashtags\":[],\"symbols\":[],\"urls\":[],\"user_mentions\":[]},\"preview_translation\":\"Considering the circumstances that Russian citizen L. Rogozin has, over a prolonged period of time, publicly expressed opinions that are in blatant contradiction to the interests of the Latvian state, I therefore urge the Minister of Foreign Affairs to include the aforementioned\",\"source_language\":\"lv\",\"translation\":\"Considering the circumstances that Russian citizen L. Rogozin has, over a prolonged period of time, publicly expressed opinions that are in blatant contradiction to the interests of the Latvian state, I therefore urge the Minister of Foreign Affairs to include the aforementioned person in the list of undesirable persons for the Republic of Latvia (persona non grata).\\n\\nIn his public activities, L. Rogozin: has blamed the West for Russia's aggressive actions;  \\nhas spoken about the ineffectiveness of sanctions, labeling them as ones that provoke Russia;  \\nhas sought to justify Russia's aggressive foreign policy, questioning whether Russia could have imperialist interests in gaining influence in Ukraine and elsewhere;  \\nhas discredited Ukraine, its political leadership, and its armed forces. His expressed opinions have often overlapped with messages aimed at reducing Western support for Ukraine;  \\nhas criticized the West and Ukraine in his public activities.\\n\\nConsequently, his actions can be regarded as ones aimed at steering Western public opinion in a direction favorable to Russia.\\n\\nDue to such activities, L. Rogozin's political undesirability in Europe (persona non grata) would be justified, but these activities are not considered to be ones that would allow for the recording of the circumstances mentioned in the Immigration Law that grant authority to the Minister of the Interior to include a person in the list of foreigners whose entry into the Republic of Latvia is prohibited; therefore, I urge the Minister of Foreign Affairs to make a decision on including the aforementioned person in the persona non grata list.\"},\"is_available\":true},\"is_translatable\":true,\"legacy\":{\"bookmark_count\":9,\"bookmarked\":false,\"conversation_id_str\":\"2105210639522140301\",\"created_at\":\"Wed Sep 30 08:18:24 +0000 2026\",\"display_text_range\":[0,274],\"entities\":{},\"favorite_count\":600,\"favorited\":false,\"full_text\":\"Post text removed by scrub-recordings.\",\"id_str\":\"2105210639522140301\",\"is_quote_status\":false,\"lang\":\"lv\",\"quote_count\":23,\"reply_count\":45,\"retweet_count\":130,\"retweeted\":false,\"user_id_str\":\"28656558\"},\"note_tweet\":{\"is_expandable\":true,\"note_tweet_results\":{\"result\":{\"entity_set\":{\"hashtags\":[],\"smarttags\":[],\"symbols\":[],\"urls\":[],\"user_mentions\":[]},\"id\":\"Tm90ZVR3ZWV0OjIxMDUyMTA2MzkzNzExNzc5ODQ=\",\"richtext\":{\"richtext_tags\":[]},\"text\":\"Ņemot vērā apstākli, ka Krievijas pilsonis L.Ragozins ilgstošā laika periodā ir publiski paudis viedokli, kas ir klajā pretrunā Latvijas valsts interesēm, tāpēc aicinu ārlietu ministri iekļaut minēto personu Latvijas Republikai nevēlamo personu (persona non grata) sarakstā.\\n\\nSavās publiskajās aktivitātes L.Ragozins: vainojis Rietumus par Krievijas agresīvo rīcību;\\nrunājis par sankciju neefektivitāti, tās dēvējot par tādām, kas provocē Krieviju;\\ncenties attaisnot Krievijas agresīvo ārpolitiku, apšaubot, ka Krievijai varētu būt imperiālistiskas intereses iegūt ietekmi Ukrainā un citviet;\\ndiskreditējis Ukrainu, tās politisko vadību un bruņotos spēkus. Viņa paustie viedokļi bieži pārklājušies ar vēstījumiem, kuru mērķis ir mazināt Rietumu atbalstu Ukrainai;\\npubliskajās aktivitātes kritizējis Rietumus un Ukrainu. \\n\\nLīdz ar to viņa darbības var tikt vērtētas kā tādas, kas ir vērstas uz to, lai Rietumu sabiedrisko domu virzītu Krievijai izdevīgā gultnē.\\n\\nŠādu aktivitāšu dēļ pamatota būtu L.Ragozina politiskā nevēlamība Eiropā (persona non grata), taču šīs aktivitātes nav uzskatāmas par tādām, kas ļautu fiksēt Imigrācijas likumā minētos apstākļus, kas dod pilnvaras iekšlietu ministram iekļaut personu ārzemnieku saraksts, kuriem ieceļošana Latvijas Republikā ir aizliegta, tāpēc aicinu ārlietu ministri pieņemt lēmumu par minētās personas iekļaušanu persona non grata sarakstā.\"}}},\"rest_id\":\"2105210639522140301\",\"source\":\"<a href=\\\"https://mobile.twitter.com\\\" rel=\\\"nofollow\\\">Twitter Web App</a>\",\"unmention_data\":{},\"views\":{\"count\":\"52751\",\"state\":\"EnabledWithCount\"}}},\"quotedRefResult\":{\"result\":{\"__typename\":\"Tweet\",\"rest_id\":\"2105210639522140301\"}},\"rest_id\":\"2105220166816592345\",\"source\":\"<a href=\\\"http://twitter.com/download/iphone\\\" rel=\\\"nofollow\\\">Twitter for iPhone</a>\",\"unmention_data\":{},\"views\":{\"count\":\"70084\",\"state\":\"EnabledWithCount\"}}},\"rest_id\":\"2105228399249654157\",\"source\":\"<a href=\\\"https://mobile.twitter.com\\\" rel=\\\"nofollow\\\">Twitter Web App</a>\",\"unmention_data\":{},\"views\":{\"count\":\"634\",\"state\":\"EnabledWithCount\"}}}}},\"entryId\":\"tweet-2105228399249654157\",\"sortIndex\":\"2105310577139122163\"},{\"content\":{\"__typename\":\"TimelineTimelineItem\",\"clientEventInfo\":{\"component\":\"organic_tweets\",\"element\":\"tweet\"},\"entryType\":\"TimelineTimelineItem\",\"itemContent\":{\"__typename\":\"TimelineTweet\",\"itemType\":\"TimelineTweet\",\"tweetDisplayType\":\"Tweet\",\"tweet_results\":{\"result\":{\"__typename\":\"Tweet\",\"cashtag_attachments\":[],\"core\":{\"user_results\":{\"result\":{\"__typename\":\"User\",\"action_counts\":{\"favorites_count\":135},\"affiliates_highlighted_label\":{},\"avatar\":{\"image_url\":\"https://abs.twimg.com/sticky/default_profile_images/default_profile_normal.png\"},\"banner\":{\"image_url\":\"https://abs.twimg.com/sticky/default_profile_images/default_profile_normal.png\"},\"core\":{\"created_at\":\"Thu Jun 30 16:13:32 +0000 2022\",\"name\":\"SOTA\",\"screen_name\":\"sotaproject\"},\"follow_request_sent\":false,\"has_graduated_access\":true,\"id\":\"VXNlcjoxNTQyNTQxNjc1ODQyNzMyMDMy\",\"is_blue_verified\":true,\"location\":{\"location\":\"\"},\"media_permissions\":{\"can_media_tag\":true},\"notifications_settings\":{\"notifications_enabled\":false},\"parody_commentary_fan_label\":\"None\",\"pinned_items\":{},\"possibly_sensitive\":false,\"privacy\":{\"protected\":false},\"professional\":{\"category\":[{\"icon_name\":\"IconBriefcaseStroke\",\"id\":580,\"name\":\"Media & News Company\"}],\"professional_type\":\"Business\",\"rest_id\":\"1542542586447106049\"},\"profile_bio\":{\"description\":\"Наверное, лучшее российское СМИ.\\nПочта редакции: mail@sotaproject.com\\ntelegram: https://t.co/A8MN1X46oo\\nАнглоязычный твиттер: https://t.co/JCBSoWBuSH\",\"entities\":{\"description\":{\"urls\":[{\"display_url\":\"t.me/sotaproject\",\"expanded_url\":\"http://t.me/sotaproject\",\"indices\":[80,103],\"url\":\"https://t.co/A8MN1X46oo\"},{\"display_url\":\"twitter.com/sotanews\",\"expanded_url\":\"https://twitter.com/sotanews\",\"indices\":[126,149],\"url\":\"https://t.co/JCBSoWBuSH\"}]},\"url\":{\"urls\":[{\"display_url\":\"t.me/sotaproject\",\"expanded_url\":\"https://t.me/sotaproject\",\"indices\":[0,23],\"url\":\"https://t.co/ygcizj0jWn\"}]}}},\"profile_description_language\":\"ru\",\"profile_image_shape\":\"Circle\",\"profile_metadata\":{\"profile_interstitial_type\":\"\"},\"profile_translation\":{\"translator_type\":\"none\"},\"relationship_counts\":{\"followers\":8371,\"following\":156},\"relationship_perspectives\":{\"blocked_by\":false,\"blocking\":false,\"followed_by\":false,\"following\":false,\"live_following\":false,\"muting\":false},\"rest_id\":\"1542541675842732032\",\"super_follow_eligible\":false,\"super_followed_by\":false,\"super_following\":false,\"tweet_counts\":{\"media_tweets\":19628,\"tweets\":30464},\"verification\":{\"verified\":false},\"website\":{\"url\":\"https://t.co/ygcizj0jWn\"}}}},\"edit_control\":{\"edit_tweet_ids\":[\"2105213716929102218\"],\"editable_until_msecs\":\"1790760637000\",\"edits_remaining\":\"5\",\"is_edit_eligible\":true},\"grok_analysis_button\":true,\"grok_annotations\":{\"is_image_editable_by_grok\":false},\"grok_translated_post_with_availability\":{\"data\":{\"associated_data\":{},\"destination_language\":\"en\",\"entities\":{\"hashtags\":[],\"symbols\":[],\"urls\":[{\"display_url\":\"user_24e6654b.com/watch?v=F4w9MA…\",\"expanded_url\":\"https://www.user_24e6654b.com/watch?v=F4w9MA6_fpo\",\"indices\":[402,425],\"url\":\"https://t.co/cD7oxpu1cU\"},{\"display_url\":\"t.me/sparishserg/908\",\"expanded_url\":\"https://t.me/sparishserg/908\",\"indices\":[1165,1188],\"url\":\"https://t.co/uRaVyVciO0\"},{\"display_url\":\"lessl.ink/Fo1rB\",\"expanded_url\":\"https://lessl.ink/Fo1rB\",\"indices\":[1404,1427],\"url\":\"https://t.co/dtLA6j8p1t\"},{\"display_url\":\"t.me/sotaproject/11…\",\"expanded_url\":\"https://t.me/sotaproject/110939\",\"indices\":[1462,1485],\"url\":\"https://t.co/ktvf3ZRV1n\"},{\"display_url\":\"t.me/sotaproject/93…\",\"expanded_url\":\"https://t.me/sotaproject/93176\",\"indices\":[1647,1670],\"url\":\"https://t.co/Vc46uI0fHO\"},{\"display_url\":\"t.me/sotaproject/96…\",\"expanded_url\":\"https://t.me/sotaproject/96019\",\"indices\":[1723,1746],\"url\":\"https://t.co/SlBmeLLnmu\"},{\"display_url\":\"baj.media/be/aglyady-man…\",\"expanded_url\":\"https://baj.media/be/aglyady-manitoringi/zajava-z-nagody-cisku-na-medyja/\",\"indices\":[2935,2958],\"url\":\"https://t.co/e4Vtgnjblk\"}],\"user_mentions\":[]},\"preview_translation\":\"Belarusian opposition figures led by Tikhonovsky are demanding an end to funding for *Nasha Niva* and structures close to Tikhonovskaya.\\n\\n*Nasha Niva* is a Belarusian publication opposed to the Lukashenko regime, loyal to the Office of Svetlana Tikhonovskaya, and regularly\",\"source_language\":\"ru\",\"translation\":\"Belarusian opposition figures led by Tikhonovsky are demanding an end to funding for *Nasha Niva* and structures close to Tikhonovskaya.\\n\\n*Nasha Niva* is a Belarusian publication opposed to the Lukashenko regime, loyal to the Office of Svetlana Tikhonovskaya, and regularly attacking her opponents within the opposition. In recent months, both the Office and *Nasha Niva*, as Sergei Tikhonovsky notes (https://t.co/cD7oxpu1cU) in his video from yesterday, have focused their efforts on criticizing him. In Tikhonovsky's view, they are downplaying his role in the 2020 protests while receiving grant money, as the real organizers of the protests face repression.\\n\\nTikhonovsky promised several countermeasures against his opponents:\\n\\n🟣 rallies by Belarusian activists against the Office and *Nasha Niva*, including at the offices of their European grant donors;\\n\\n🟣 an investigation into the Office's financial schemes;\\n\\n🟣 monitoring of the Office's and *Nasha Niva*'s actions against other opposition figures, with donors to be informed of the monitoring results.\\n\\nIn support of Tikhonovsky's appeal, Belarusian activists (including Dmitry Bolkunets, Sergei Sparish (https://t.co/uRaVyVciO0), and Vitaly Kondratenko) have begun collecting signatures for a letter demanding \\\"an independent investigation into hybrid attacks on Belarusian activists in exile.\\\" We recall that Kondratenko, after an interview (https://t.co/dtLA6j8p1t) with him by *Sota*, was exposed (https://t.co/ktvf3ZRV1n) by *Nasha Niva* as working as a courier.\\n\\nTargets of *Nasha Niva*'s information attacks have included, in particular, the opposition party *Narodnaya Hramada* (https://t.co/Vc46uI0fHO), which opposes Tikhonovskaya's Office, journalist (https://t.co/SlBmeLLnmu) Olga Semashko, and others. None of the accusations have been substantiated.\\n\\n\\\"Monitoring,\\\" the letter states, \\\"documents a consistent practice of information attacks by *Nasha Niva*: the discreditation and defamation of independent activists, the destruction of trust in them, and the granting of serious accusations the status of journalistically verified information in the absence of sufficient independent verification and a verifiable factual basis. This is not harmless media polemic. When combined with the institutional influence of structures close to Svetlana Tikhonovskaya, such practices turn into a tool of pressure capable of threatening the safety, reputation, and migration status of Belarusians in exile.\\\"\\n\\nAs an example, the letter cites the long-suppressed sexual harassment by BYSOL fund head Andrei Strizhak of Belarusian female emigrants.\\n\\n\\\"After receiving this monitoring, continuing support without independent verification means that the donor consciously accepts the risk of funding a system that may cause further harm to victims and endanger people in exile,\\\" the letter concludes.\\n\\nIt is worth noting that the Belarusian Association of Journalists in exile (https://t.co/e4Vtgnjblk) spoke out (without mentioning his name) against Tikhonovsky's actions: \\\"...the standard of freedom of speech protects not only criticism of such figures but also a certain degree of sharpness, exaggeration, provocation, and even irritating forms of its presentation. Expressing dissatisfaction with such publications is the right of every person. However, threats to apply certain pressure mechanisms, including those related to journalists' safety, are already an attempt at censorship, which is unacceptable.\\\"\"},\"is_available\":true},\"is_translatable\":false,\"legacy\":{\"bookmark_count\":5,\"bookmarked\":false,\"conversation_id_str\":\"2105213716929102218\",\"created_at\":\"Wed Sep 30 08:30:37 +0000 2026\",\"display_text_range\":[0,273],\"entities\":{\"media\":[{\"additional_media_info\":{\"monetizable\":false},\"allow_download_status\":{\"allow_download\":true},\"display_url\":\"pic.x.com/vvyY5myJzb\",\"expanded_url\":\"https://x.com/sotaproject/status/2105213716929102218/video/1\",\"ext_media_availability\":{\"status\":\"Available\"},\"id_str\":\"2105213671672524800\",\"indices\":[274,297],\"media_key\":\"13_2105213671672524800\",\"media_results\":{\"result\":{\"media_key\":\"13_2105213671672524800\"}},\"media_url_https\":\"https://pbs.twimg.com/amplify_video_thumb/2105213671672524800/img/L9932HfmOyjVq7hl.jpg\",\"original_info\":{\"focus_rects\":[],\"height\":1280,\"width\":720},\"sizes\":{\"large\":{\"h\":1280,\"resize\":\"fit\",\"w\":720},\"medium\":{\"h\":1200,\"resize\":\"fit\",\"w\":675},\"small\":{\"h\":680,\"resize\":\"fit\",\"w\":383},\"thumb\":{\"h\":150,\"resize\":\"crop\",\"w\":150}},\"type\":\"video\",\"url\":\"https://t.co/vvyY5myJzb\",\"video_info\":{\"aspect_ratio\":[9,16],\"duration_millis\":114833,\"variants\":[{\"content_type\":\"application/x-mpegURL\",\"url\":\"https://video.twimg.com/amplify_video/2105213671672524800/pl/yxzf8QfxyU_oGire.m3u8?tag=29&v=863\"},{\"bitrate\":632000,\"content_type\":\"video/mp4\",\"url\":\"https://video.twimg.com/amplify_video/2105213671672524800/vid/avc1/320x568/jYN3UViq_EPJprnd.mp4?tag=29\"},{\"bitrate\":950000,\"content_type\":\"video/mp4\",\"url\":\"https://video.twimg.com/amplify_video/2105213671672524800/vid/avc1/480x852/4AXANJMGM7DJMjN7.mp4?tag=29\"},{\"bitrate\":2176000,\"content_type\":\"video/mp4\",\"url\":\"https://video.twimg.com/amplify_video/2105213671672524800/vid/avc1/720x1280/44qlPtHnzz-X-lfs.mp4?tag=29\"}]}}]},\"extended_entities\":{\"media\":[{\"additional_media_info\":{\"monetizable\":false},\"allow_download_status\":{\"allow_download\":true},\"display_url\":\"pic.x.com/vvyY5myJzb\",\"expanded_url\":\"https://x.com/sotaproject/status/2105213716929102218/video/1\",\"ext_media_availability\":{\"status\":\"Available\"},\"id_str\":\"2105213671672524800\",\"indices\":[274,297],\"media_key\":\"13_2105213671672524800\",\"media_results\":{\"result\":{\"media_key\":\"13_2105213671672524800\"}},\"media_url_https\":\"https://pbs.twimg.com/amplify_video_thumb/2105213671672524800/img/L9932HfmOyjVq7hl.jpg\",\"original_info\":{\"focus_rects\":[],\"height\":1280,\"width\":720},\"sizes\":{\"large\":{\"h\":1280,\"resize\":\"fit\",\"w\":720},\"medium\":{\"h\":1200,\"resize\":\"fit\",\"w\":675},\"small\":{\"h\":680,\"resize\":\"fit\",\"w\":383},\"thumb\":{\"h\":150,\"resize\":\"crop\",\"w\":150}},\"type\":\"video\",\"url\":\"https://t.co/vvyY5myJzb\",\"video_info\":{\"aspect_ratio\":[9,16],\"duration_millis\":114833,\"variants\":[{\"content_type\":\"application/x-mpegURL\",\"url\":\"https://video.twimg.com/amplify_video/2105213671672524800/pl/yxzf8QfxyU_oGire.m3u8?tag=29&v=863\"},{\"bitrate\":632000,\"content_type\":\"video/mp4\",\"url\":\"https://video.twimg.com/amplify_video/2105213671672524800/vid/avc1/320x568/jYN3UViq_EPJprnd.mp4?tag=29\"},{\"bitrate\":950000,\"content_type\":\"video/mp4\",\"url\":\"https://video.twimg.com/amplify_video/2105213671672524800/vid/avc1/480x852/4AXANJMGM7DJMjN7.mp4?tag=29\"},{\"bitrate\":2176000,\"content_type\":\"video/mp4\",\"url\":\"https://video.twimg.com/amplify_video/2105213671672524800/vid/avc1/720x1280/44qlPtHnzz-X-lfs.mp4?tag=29\"}]}}]},\"favorite_count\":7,\"favorited\":false,\"full_text\":\"Post text removed by scrub-recordings.\",\"id_str\":\"2105213716929102218\",\"is_quote_status\":false,\"lang\":\"ru\",\"possibly_sensitive\":false,\"possibly_sensitive_editable\":true,\"quote_count\":0,\"reply_count\":4,\"retweet_count\":0,\"retweeted\":false,\"user_id_str\":\"1542541675842732032\"},\"note_tweet\":{\"is_expandable\":true,\"note_tweet_results\":{\"result\":{\"entity_set\":{\"hashtags\":[],\"smarttags\":[],\"symbols\":[],\"timestamps\":[],\"urls\":[{\"display_url\":\"user_24e6654b.com/watch?v=F4w9MA…\",\"expanded_url\":\"https://www.user_24e6654b.com/watch?v=F4w9MA6_fpo\",\"indices\":[341,364],\"url\":\"https://t.co/cD7oxpu1cU\"},{\"display_url\":\"t.me/sparishserg/908\",\"expanded_url\":\"https://t.me/sparishserg/908\",\"indices\":[1071,1094],\"url\":\"https://t.co/uRaVyVciO0\"},{\"display_url\":\"lessl.ink/Fo1rB\",\"expanded_url\":\"https://lessl.ink/Fo1rB\",\"indices\":[1293,1316],\"url\":\"https://t.co/dtLA6j8p1t\"},{\"display_url\":\"t.me/sotaproject/11…\",\"expanded_url\":\"https://t.me/sotaproject/110939\",\"indices\":[1343,1366],\"url\":\"https://t.co/ktvf3ZRV1n\"},{\"display_url\":\"t.me/sotaproject/93…\",\"expanded_url\":\"https://t.me/sotaproject/93176\",\"indices\":[1559,1582],\"url\":\"https://t.co/Vc46uI0fHO\"},{\"display_url\":\"t.me/sotaproject/96…\",\"expanded_url\":\"https://t.me/sotaproject/96019\",\"indices\":[1598,1621],\"url\":\"https://t.co/SlBmeLLnmu\"},{\"display_url\":\"baj.media/be/aglyady-man…\",\"expanded_url\":\"https://baj.media/be/aglyady-manitoringi/zajava-z-nagody-cisku-na-medyja/\",\"indices\":[2845,2868],\"url\":\"https://t.co/e4Vtgnjblk\"}],\"user_mentions\":[]},\"id\":\"Tm90ZVR3ZWV0OjIxMDUyMTM3MTY1ODk0MTY0NDg=\",\"richtext\":{\"richtext_tags\":[]},\"text\":\"Белорусские оппозиционеры во главе с Тихановским требуют прекращения финансирования «Нашей нивы» и структур, близких к Тихановской.\\n\\n«Наша нива» – оппозиционное режиму Лукашенко белорусское издание, лояльное Офису Светланы Тихановской и регулярно атакующее ее противников в оппозиции. В последние месяцы и Офис, и «Наша нива», как отмечает (https://t.co/cD7oxpu1cU) в своем вчерашнем видео Сергей Тихановский, сосредоточили свои усилия на его критике. По мнению Тихановского, они нивелируют его роль в протестах 2020 года и получают грантовые деньги, пока реальные организаторы протестов подвергаются репрессиям.\\n\\nТихановский пообещал несколько мер противодействия своим оппонентам:\\n\\n🟣 митинги белорусских активистов против Офиса и «Нашей нивы», в том числе у офисов их европейских грантодателей;\\n\\n🟣 расследование финансовых схем Офиса;\\n\\n🟣 мониторинг действий Офиса и «Нашей нивы» по борьбе с другими оппозиционерами ознакомление с итогами этого мониторинга доноров.\\n\\nВ поддержку обращения Тихановского белорусские активисты (в том числе Дмитрий Болкунец, Сергей Спариш (https://t.co/uRaVyVciO0) и Виталий Кондратенко) начали собирать подписи под письмом с «требованием независимого расследования гибридных атак на белорусских активистов в изгнании». Напомним, что Кондратенко после интервью (https://t.co/dtLA6j8p1t) с ним «Соты» был уличен (https://t.co/ktvf3ZRV1n) «Нашей нивой» в том, что он работает курьером.\\n\\nОбъектами информационных атак «Нашей нивы» становились, в частности, противостоящие Офису Тихановской оппозиционная партия «Народная громада» (https://t.co/Vc46uI0fHO), журналистка (https://t.co/SlBmeLLnmu) Ольга Семашко и др. Все обвинения подтверждений не нашли.\\n\\n«Мониторинг, – говорится в письме, – документирует устойчивую практику информационных атак со стороны «Нашей Нивы»: дискредитацию и диффамацию независимых активистов, разрушение доверия к ним и придание тяжелым обвинениям статуса журналистски проверенной информации при отсутствии достаточной независимой верификации и проверяемой фактической базы. Это не безобидная медийная полемика. В сочетании с институциональным влиянием структур, приближённых к Светлане Тихановской, такая практика превращается в инструмент давления, способный ставить под угрозу безопасность, репутацию и миграционный статус белорусов в изгнании».\\n\\nВ качестве примера в письме приводятся долгое время замалчивавшиеся сексуальные домогательства руководителя фонда BYSOL Андрея Стрижака к белорусским эмигранткам.\\n\\n«После получения этого мониторинга продолжение поддержки без независимой проверки означает, что донор осознанно принимает риск финансирования системы, которая может причинять дальнейший вред пострадавшим и подвергать опасности людей, находящихся в изгнании», – делается вывод в письме.\\n\\nОтметим, что с осуждением действий Тихановского – без упоминания его имени – выступила (https://t.co/e4Vtgnjblk) находящаяся в эмиграции Белорусская ассоциация журналистов: «…стандарт свободы слова защищает не только критику таких личностей, но и определенную степень резкости, преувеличения, провокации и даже раздражающей формы ее изложения. Выражение недовольства подобными публикациями — право каждого человека. Однако угрозы применения определённых механизмов давления, в том числе связанных с безопасностью журналистов, уже являются попыткой цензуры, что недопустимо».\"}}},\"quick_promote_eligibility\":{\"eligibility\":\"IneligibleNotVerified\"},\"rest_id\":\"2105213716929102218\",\"source\":\"<a href=\\\"https://mobile.twitter.com\\\" rel=\\\"nofollow\\\">Twitter Web App</a>\",\"unmention_data\":{},\"views\":{\"count\":\"3552\",\"state\":\"EnabledWithCount\"}}}}},\"entryId\":\"tweet-2105213716929102218\",\"sortIndex\":\"2105310577139122162\"},{\"content\":{\"__typename\":\"TimelineTimelineItem\",\"clientEventInfo\":{\"component\":\"organic_tweets\",\"element\":\"tweet\"},\"entryType\":\"TimelineTimelineItem\",\"itemContent\":{\"__typename\":\"TimelineTweet\",\"itemType\":\"TimelineTweet\",\"tweetDisplayType\":\"Tweet\",\"tweet_results\":{\"result\":{\"__typename\":\"Tweet\",\"cashtag_attachments\":[],\"core\":{\"user_results\":{\"result\":{\"__typename\":\"User\",\"action_counts\":{\"favorites_count\":135},\"affiliates_highlighted_label\":{},\"avatar\":{\"image_url\":\"https://abs.twimg.com/sticky/default_profile_images/default_profile_normal.png\"},\"banner\":{\"image_url\":\"https://abs.twimg.com/sticky/default_profile_images/default_profile_normal.png\"},\"core\":{\"created_at\":\"Thu Jun 30 16:13:32 +0000 2022\",\"name\":\"SOTA\",\"screen_name\":\"sotaproject\"},\"follow_request_sent\":false,\"has_graduated_access\":true,\"id\":\"VXNlcjoxNTQyNTQxNjc1ODQyNzMyMDMy\",\"is_blue_verified\":true,\"location\":{\"location\":\"\"},\"media_permissions\":{\"can_media_tag\":true},\"notifications_settings\":{\"notifications_enabled\":false},\"parody_commentary_fan_label\":\"None\",\"pinned_items\":{},\"possibly_sensitive\":false,\"privacy\":{\"protected\":false},\"professional\":{\"category\":[{\"icon_name\":\"IconBriefcaseStroke\",\"id\":580,\"name\":\"Media & News Company\"}],\"professional_type\":\"Business\",\"rest_id\":\"1542542586447106049\"},\"profile_bio\":{\"description\":\"Наверное, лучшее российское СМИ.\\nПочта редакции: mail@sotaproject.com\\ntelegram: https://t.co/A8MN1X46oo\\nАнглоязычный твиттер: https://t.co/JCBSoWBuSH\",\"entities\":{\"description\":{\"urls\":[{\"display_url\":\"t.me/sotaproject\",\"expanded_url\":\"http://t.me/sotaproject\",\"indices\":[80,103],\"url\":\"https://t.co/A8MN1X46oo\"},{\"display_url\":\"twitter.com/sotanews\",\"expanded_url\":\"https://twitter.com/sotanews\",\"indices\":[126,149],\"url\":\"https://t.co/JCBSoWBuSH\"}]},\"url\":{\"urls\":[{\"display_url\":\"t.me/sotaproject\",\"expanded_url\":\"https://t.me/sotaproject\",\"indices\":[0,23],\"url\":\"https://t.co/ygcizj0jWn\"}]}}},\"profile_description_language\":\"ru\",\"profile_image_shape\":\"Circle\",\"profile_metadata\":{\"profile_interstitial_type\":\"\"},\"profile_translation\":{\"translator_type\":\"none\"},\"relationship_counts\":{\"followers\":8371,\"following\":156},\"relationship_perspectives\":{\"blocked_by\":false,\"blocking\":false,\"followed_by\":false,\"following\":false,\"live_following\":false,\"muting\":false},\"rest_id\":\"1542541675842732032\",\"super_follow_eligible\":false,\"super_followed_by\":false,\"super_following\":false,\"tweet_counts\":{\"media_tweets\":19628,\"tweets\":30464},\"verification\":{\"verified\":false},\"website\":{\"url\":\"https://t.co/ygcizj0jWn\"}}}},\"edit_control\":{\"edit_tweet_ids\":[\"2105199700382986322\"],\"editable_until_msecs\":\"1790757295000\",\"edits_remaining\":\"5\",\"is_edit_eligible\":true},\"grok_analysis_button\":true,\"grok_annotations\":{\"is_image_editable_by_grok\":false},\"grok_translated_post_with_availability\":{\"data\":{\"associated_data\":{},\"destination_language\":\"en\",\"entities\":{\"hashtags\":[],\"symbols\":[],\"urls\":[],\"user_mentions\":[]},\"preview_translation\":\"A protocol has been drawn up against a Novosibirsk resident for calling not to support United Russia.\\n\\nThe protocol's subject is Novosibirsk resident Sergei Volkov: a video with his call was posted on user_24e6654b on September 7.\\n\\nFrom the perspective of the regional election\",\"source_language\":\"ru\",\"translation\":\"A protocol has been drawn up against a Novosibirsk resident for calling not to support United Russia.\\n\\nThe protocol's subject is Novosibirsk resident Sergei Volkov: a video with his call was posted on user_24e6654b on September 7.\\n\\nFrom the perspective of the regional election commission and, as claimed by politician Svetlana Kaverzina, who published the document, the center \\\"E,\\\" expressing one's opinion about politics during the pre-election period constitutes a violation of Article 5.12 of the Code of Administrative Offenses: \\\"Production, distribution, or placement of campaign materials in violation of the requirements of the legislation on elections and referendums\\\" (fine for individuals up to 25 thousand rubles).\"},\"is_available\":true},\"is_translatable\":false,\"legacy\":{\"bookmark_count\":1,\"bookmarked\":false,\"conversation_id_str\":\"2105199700382986322\",\"created_at\":\"Wed Sep 30 07:34:55 +0000 2026\",\"display_text_range\":[0,274],\"entities\":{\"media\":[{\"allow_download_status\":{\"allow_download\":true},\"display_url\":\"pic.x.com/bOto1trS5H\",\"expanded_url\":\"https://x.com/sotaproject/status/2105199700382986322/photo/1\",\"ext_media_availability\":{\"status\":\"Available\"},\"features\":{\"large\":{\"faces\":[]},\"medium\":{\"faces\":[]},\"orig\":{\"faces\":[]},\"small\":{\"faces\":[]}},\"id_str\":\"2105199666002284544\",\"indices\":[275,298],\"media_key\":\"3_2105199666002284544\",\"media_results\":{\"result\":{\"media_key\":\"3_2105199666002284544\"}},\"media_url_https\":\"https://pbs.twimg.com/media/HTcr8UFWUAAIc59.jpg\",\"original_info\":{\"focus_rects\":[{\"h\":380,\"w\":678,\"x\":0,\"y\":17},{\"h\":678,\"w\":678,\"x\":0,\"y\":0},{\"h\":773,\"w\":678,\"x\":0,\"y\":0},{\"h\":924,\"w\":462,\"x\":108,\"y\":0},{\"h\":924,\"w\":678,\"x\":0,\"y\":0}],\"height\":924,\"width\":678},\"sizes\":{\"large\":{\"h\":924,\"resize\":\"fit\",\"w\":678},\"medium\":{\"h\":924,\"resize\":\"fit\",\"w\":678},\"small\":{\"h\":680,\"resize\":\"fit\",\"w\":499},\"thumb\":{\"h\":150,\"resize\":\"crop\",\"w\":
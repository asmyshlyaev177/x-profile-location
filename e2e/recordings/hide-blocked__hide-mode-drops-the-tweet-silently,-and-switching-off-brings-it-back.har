"351640699\",\"indices\":[22,35],\"name\":\"User 42ab\",\"screen_name\":\"user_42ab3a15\"}]},\"favorite_count\":8,\"favorited\":false,\"full_text\":\"Post text removed by scrub-recordings.\",\"id_str\":\"2052173876583633213\",\"in_reply_to_screen_name\":\"NASAArtemis\",\"in_reply_to_status_id_str\":\"2052108727839285751\",\"in_reply_to_user_id_str\":\"632344577\",\"is_quote_status\":false,\"lang\":\"en\",\"quote_count\":0,\"reply_count\":1,\"retweet_count\":3,\"retweeted\":false,\"user_id_str\":\"2041575020871258112\"},\"note_tweet\":{\"is_expandable\":true,\"note_tweet_results\":{\"result\":{\"entity_set\":{\"hashtags\":[{\"indices\":[393,401],\"text\":\"Artemis\"},{\"indices\":[402,415],\"text\":\"SpaceScience\"},{\"indices\":[416,429],\"text\":\"Microgravity\"},{\"indices\":[430,440],\"text\":\"Astronomy\"},{\"indices\":[441,456],\"text\":\"user_766cf31d\"}],\"smarttags\":[],\"symbols\":[],\"urls\":[],\"user_mentions\":[]},\"id\":\"Tm90ZVR3ZWV0OjIwNTIxNzM4NzY0OTEzNzg2ODg=\",\"richtext\":{\"richtext_tags\":[]},\"text\":\"The physics behind the fun: in microgravity, surface tension wins.\\nOn Earth, gravity pulls water into a flat puddle. In space, water pulls itself into a perfect sphere — because molecules on the surface attract each other equally in all directions with nothing to flatten them out.\\nSame water. Completely different universe of behaviour. That's why Jeremy's crewmates had so much to teach. 💧\\n\\n#Artemis #SpaceScience #Microgravity #Astronomy #user_766cf31d\"}}},\"quick_promote_eligibility\":{\"eligibility\":\"IneligibleNotVerified\"},\"rest_id\":\"2052173876583633213\",\"unmention_data\":{},\"views\":{\"count\":\"1188\",\"state\":\"EnabledWithCount\"}}}}}}],\"metadata\":{\"conversationMetadata\":{\"allTweetIds\":[\"2052173876583633213\"],\"enableDeduplication\":true}}},\"entryId\":\"conversationthread-2052173876583633213\",\"sortIndex\":\"2119523552074923992\"},{\"content\":{\"__typename\":\"TimelineTimelineModule\",\"clientEventInfo\":{\"compo
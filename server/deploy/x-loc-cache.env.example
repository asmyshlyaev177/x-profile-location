# Copy to /etc/x-loc-cache.env (root:root, 0644) — read by the systemd unit.
# Every value here is a default the server already uses; the file exists so the
# tuning is visible in one place rather than implied.

# Loopback only: Caddy terminates TLS and proxies to this. Do not expose the
# Node process directly — it has no TLS and its rate limiter is a backstop, not
# an edge.
XLOC_HOST=127.0.0.1
XLOC_PORT=8787

# Must live under the unit's StateDirectory (/var/lib/x-loc-cache).
XLOC_DB=/var/lib/x-loc-cache/x-loc-cache.db

# SQLite page cache — real resident memory once the database outgrows it. Keep
# in step with MemoryMax in the unit file.
XLOC_CACHE_MB=256
# Memory-mapped I/O ceiling. Address space backed by the OS page cache, so it is
# reclaimable and can safely exceed free RAM.
XLOC_MMAP_MB=512

# Retention sweep interval (the Worker gets this from a cron trigger instead).
XLOC_RETENTION_INTERVAL_HOURS=24

# Request limits. A full 100-username lookup is ~1.5 KB and a 50-entry
# contribution ~4 KB, so 256 KB is far above anything a real client sends.
XLOC_MAX_BODY_KB=256

# Per-IP fixed window — a flood ceiling, not a fair-use quota, and set high
# because one IP is not one user. Offices, universities and mobile CGNAT put many
# installs behind a single address, and a false positive is expensive: the client
# treats 429 as a failure and three in a row open its circuit breaker for ten
# minutes, so clipping a legitimate burst costs that user the shared cache far
# longer than the burst lasted.
#
# Budget: a heavy scroller bursts ~20-30 req/min, so 600 leaves room for ~20
# simultaneously-active users on one IP and many more typical ones, while still
# capping a single host at 10 req/s. Raise it if you know you have a large NAT
# population; set 0 to disable and let the reverse proxy own this instead.
XLOC_RATE_LIMIT=600
XLOC_RATE_WINDOW_S=60

# Take the client IP from X-Forwarded-For. Correct behind Caddy; set to 0 if the
# server is ever exposed directly, or clients can forge their own rate-limit
# identity.
XLOC_TRUST_PROXY=1

# How often to log the usage summary (one JSON line per window; see "Usage
# stats" in README.md). 24 means a daily line. 0 disables reporting entirely.
# Counters reset each time they are logged, so each line describes its own
# window rather than everything since boot.
XLOC_STATS_INTERVAL_HOURS=24

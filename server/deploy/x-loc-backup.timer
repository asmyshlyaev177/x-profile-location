#  /etc/systemd/system/x-loc-backup.timer
#
#  sudo systemctl enable --now x-loc-backup.timer

[Unit]
Description=Daily x-loc-cache database backup

[Timer]
# 10:00 UTC = 14:00 in Tbilisi (GMT+4, no DST) = early morning across the US,
# where most of the audience is — the quietest window for the auto vacuum the
# backup run may perform. Pinned to UTC so the box's own timezone cannot move
# it, and so snapshot *filenames* (stamped UTC by backup.ts) match the hour.
OnCalendar=*-*-* 10:00:00 UTC
# No RandomizedDelaySec: this is a time somebody chose, and jitter would only
# smear it across the following hour. The usual reason for it — spreading many
# machines off a round hour — does not apply to one box on a bespoke time.
RandomizedDelaySec=0
# A box that was down at 10:00 takes its backup on boot instead of skipping the day.
Persistent=true

[Install]
WantedBy=timers.target

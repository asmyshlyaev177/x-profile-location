#  /etc/systemd/system/x-loc-vacuum.service
#
#  Not a timer: x-loc-backup.service triggers it with OnSuccess=, so a rebuild
#  only ever follows the verified archive it would be restored from.
#
#  Root, unlike every other unit here, because it stops and starts the service
#  around the swap. vacuum.ts chowns the rebuilt file back to xloc.

[Unit]
Description=x-loc-cache — rebuild the database when the last backup measured it as bloated
Documentation=https://github.com/asmyshlyaev177/x-profile-location
OnFailure=x-loc-alert@%n.service

[Service]
Type=oneshot
ExecStart=/opt/x-loc-cache/server/deploy/vacuum.ts --if-needed
# XLOC_DB, XLOC_BACKUP_DIR and XLOC_AUTO_VACUUM_PCT must be the ones they used.
EnvironmentFile=/etc/x-loc-cache.env
# The rebuild is the whole downtime and scales with the database: 0.6s at 236 MB,
# 47s at 10 GB. A timeout here kills it mid-swap, for guardSwap to undo.
TimeoutStartSec=900

# No sandboxing: it drives systemctl, chown and mv by design.
NoNewPrivileges=no

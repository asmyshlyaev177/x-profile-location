#  /etc/systemd/system/x-loc-cache.service
#
#  Assumes Node is installed system-wide at /usr/bin/node (NodeSource apt
#  package). With nvm instead, three things change:
#    * ExecStart must be the absolute interpreter path — systemd does not expand
#      variables or $PATH there. Get it with: readlink -f "$(which node)"
#    * that path is under /home, so ProtectHome=yes below would hide it. Set
#      ProtectHome=no, or install Node system-wide and keep the hardening.
#    * better-sqlite3 is a native module, so `npm install` must run under the
#      *same* Node that ExecStart names. Installing under nvm and then running
#      /usr/bin/node fails at startup with ERR_DLOPEN_FAILED / NODE_MODULE_VERSION.
#  See README.md ("Deploy: Node + SQLite on a VPS").

[Unit]
Description=x-loc-cache — shared location cache for the X Profile Location extension
Documentation=https://github.com/asmyshlyaev177/x-profile-location
After=network-online.target
Wants=network-online.target
# Restart=always means this unit only reaches "failed" once systemd gives up
# restarting it — a crash loop, not a blip. That is worth an email. Inert until
# /etc/x-loc-alert.env exists.
OnFailure=x-loc-alert@%n.service

[Service]
Type=simple
User=xloc
Group=xloc
WorkingDirectory=/opt/x-loc-cache/server
# dist/node-server.js is src/ bundled by `pnpm build` and committed, so a pull
# brings the code and a rollback brings back the bundle that matches it. Running
# the .ts directly costs ~20 MB: Node keeps its WebAssembly type stripper loaded.
# --max-semi-space-size=1 caps V8's young generation: left alone it grew to
# 32-64 MB under load and kept it, and the cap measured no slower in pnpm bench.
ExecStart=/usr/bin/node --max-semi-space-size=1 dist/node-server.js
EnvironmentFile=/etc/x-loc-cache.env

# The server closes the listener, checkpoints WAL and exits on SIGTERM; give it
# room to finish rather than being killed mid-write.
KillSignal=SIGTERM
TimeoutStopSec=15
Restart=always
RestartSec=2

# systemd creates and chowns /var/lib/x-loc-cache — point XLOC_DB inside it.
StateDirectory=x-loc-cache

# Memory ceiling. Anonymous memory — Node plus XLOC_CACHE_MB of SQLite page
# cache — measured 73 MB after 20k requests and a retention pass at 600k
# profiles. The rest is room for mmap'd database pages, which are file-backed and
# reclaimed first, so lowering this evicts them sooner and saves nothing. Raise
# this and XLOC_CACHE_MB together, never one alone.
MemoryMax=640M

# Hardening. Nothing here needs privileges: one listening socket on loopback and
# one directory to write.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target

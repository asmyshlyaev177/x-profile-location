# Copy to /etc/x-loc-alert.env — it holds an SMTP password, so unlike
# /etc/x-loc-cache.env this one is NOT world-readable:
#
#   sudo install -m 0640 -o root -g xloc x-loc-alert.env.example /etc/x-loc-alert.env
#   sudo editor /etc/x-loc-alert.env
#
# Variable names match the usual nodemailer set, so values can be copied
# straight over from an existing notifier's .env.
#
# Omit SMTP_HOST (or don't create this file) and alerting is simply off: the
# alert unit logs "nothing to send" and exits 0. Setting SMTP_HOST while
# leaving SMTP_USER / SMTP_PASS / NOTIFY_TO blank is treated as a mistake and
# fails loudly — half-configured alerting is worse than none, because it looks
# like it is working.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Implicit TLS on 465, STARTTLS on 587. Left unset, it is inferred from the port.
SMTP_SECURE=true

# Gmail rejects an account password here. Create an App Password instead:
# https://myaccount.google.com/apppasswords  (needs 2FA on the account).
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password

# Comma-separated for several recipients.
NOTIFY_TO=you@example.com
# Gmail rewrites this to the authenticated account unless it is a verified
# alias, so it is normally left equal to SMTP_USER.
NOTIFY_FROM=you@gmail.com

# Subject prefix, for filtering. Default: [x-pat-cache]
#XLOC_ALERT_PREFIX=[x-pat-cache]

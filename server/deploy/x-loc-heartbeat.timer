#  /etc/systemd/system/x-loc-heartbeat.timer
#
#  sudo systemctl enable --now x-loc-heartbeat.timer

[Unit]
Description=Weekly x-loc-cache backup heartbeat

[Timer]
OnCalendar=Mon 09:00
RandomizedDelaySec=30m
# A box that was down on Monday still reports when it comes back, rather than
# skipping the week — the whole point is that a missing email means something.
Persistent=true

[Install]
WantedBy=timers.target

{
  "name": "x-pat-cache",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared, crowdsourced location cache for the X-Pat extension (Cloudflare Worker + D1, or Node + SQLite).",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create x-loc-cache",
    "db:init": "wrangler d1 execute x-loc-cache --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute x-loc-cache --local --file=./schema.sql",
    "start": "node --experimental-strip-types --env-file-if-exists=.env src/node-server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:deploy": "vitest run --config vitest.deploy.config.ts",
    "bench": "node --experimental-strip-types bench/load.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.0",
    "nodemailer": "^8.0.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "25.5.0",
    "@types/nodemailer": "^6.4.15",
    "typescript": "6.0.2",
    "vitest": "4.1.2",
    "wrangler": "^3.99.0"
  },
  "engines": {
    "node": ">=22.6"
  }
}

# Native module built for the host's Node ABI — must be rebuilt in the image.
node_modules

# Local databases; the container's lives in the /data volume.
data
*.db
*.db-wal
*.db-shm

# Secrets and host-specific config.
.env
.env.*

# Not used at runtime.
src/*.test.ts
deploy/*.test.ts
vitest.config.ts
vitest.deploy.config.ts
tsconfig.json
wrangler.toml
README.md
Dockerfile
compose.yaml

# deploy/ is systemd wiring the container has no use for — except backup.sh and
# alert.ts, deliberately the *same* files both deploy shapes run. The negations
# must follow the exclusion; last match wins.
deploy
!deploy/backup.sh
!deploy/alert.ts

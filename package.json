{
  "name": "X Profile Viewer",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bedframe dev",
    "build": "bedframe build",
    "preview": "vite preview",
    "publish": "bedframe publish -b",
    "zip": "bedframe zip",
    "format": "oxfmt .",
    "lint": "oxlint --fix .",
    "fix": "npm run format && npm run lint",
    "test": "vitest run --coverage",
    "convert:safari": "xcrun safari-web-extension-converter dist/safari --project-location . --app-name $npm_package_name-safari"
  },
  "dependencies": {
    "preact": "^10.29.0"
  },
  "devDependencies": {
    "@bedframe/cli": "^0.1.2",
    "@preact/preset-vite": "^2.10.4",
    "@types/node": "latest",
    "typescript": "latest",
    "vite": "latest",
    "@bedframe/core": "^0.1.0",
    "@types/chrome": "latest",
    "concurrently": "latest",
    "@vitest/coverage-istanbul": "latest",
    "happy-dom": "latest",
    "vitest": "latest",
    "globals": "latest",
    "lint-staged": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "@tailwindcss/postcss": "latest",
    "@tailwindcss/vite": "latest",
    "postcss": "latest",
    "tailwindcss": "latest"
  },
  "description": "X Profile Viewer",
  "license": "UNLICENSED",
  "author": {
    "name": "asmyshlyaev177",
    "url": "https://asmyshlyaev177.dev"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,html,json}": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx}": "oxlint --fix"
  }
}

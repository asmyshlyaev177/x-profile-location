{
  "name": "x-pat",
  "private": true,
  "version": "1.7.3",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others \"pnpm proxy\" \"pnpm dev:app\"",
    "build": "bedframe build && bedframe zip",
    "build:worker": "VITE_CACHE_API_BASE=https://x-loc-cache.asmyshlyaev177.workers.dev bedframe build",
    "build:nocache": "VITE_CACHE_API_BASE= bedframe build",
    "preview": "vite preview",
    "publish": "bedframe publish -b",
    "zip": "bedframe zip",
    "format": "oxfmt .",
    "lint": "oxlint --fix .",
    "lint:dup": "jscpd",
    "fix": "npm run lint && npm run format",
    "lint-staged": "lint-staged",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "test": "vitest run --coverage",
    "typecheck": "tsc -b",
    "locales": "node scripts/sync-locales.mjs",
    "test:shuffle": "vitest run --sequence.shuffle",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:integration": "playwright test -c playwright.integration.config.ts",
    "test:lighthouse": "pnpm --filter x-pat-landing test:lighthouse",
    "e2e:profile": "node e2e/scripts/seed-profile.mjs",
    "test:e2e": "playwright test --retries 1",
    "shots": "SHOOT=1 E2E_HEADED=1 xvfb-run --auto-servernum playwright test e2e/screenshots.test.ts && node landing/scripts/store-canvas.mjs && cd landing && xvfb-run --auto-servernum node scripts/shoot-options.mjs",
    "scrub": "node --max-old-space-size=6144 scripts/scrub-recordings.mjs",
    "scrub:check": "node --max-old-space-size=6144 scripts/scrub-recordings.mjs --check",
    "test:e2e:ui": "E2E_HEADED=1 playwright test --ui",
    "convert:safari": "xcrun safari-web-extension-converter dist/safari --project-location . --app-name $npm_package_name-safari",
    "proxy": "test-proxy-recorder",
    "test:e2e:record": "E2E_HEADED=1 playwright test --workers 1 --ui; pnpm run scrub",
    "dev:app": "bedframe dev",
    "dev:firefox": "vite build --mode firefox && web-ext run --source-dir dist/firefox --firefox-profile e2e/.auth/firefox-profile --profile-create-if-missing --keep-profile-changes --start-url https://x.com"
  },
  "dependencies": {
    "idb-keyval": "^6.2.2",
    "preact": "^10.29.0"
  },
  "devDependencies": {
    "@bedframe/cli": "^0.1.2",
    "@bedframe/core": "^0.1.0",
    "@playwright/test": "^1.59.1",
    "@preact/preset-vite": "^2.10.4",
    "@tailwindcss/postcss": "4.2.2",
    "@tailwindcss/vite": "4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "0.1.38",
    "@types/node": "25.5.0",
    "@vitest/coverage-istanbul": "4.1.2",
    "concurrently": "9.2.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "17.4.0",
    "happy-dom": "20.8.9",
    "jscpd": "^5.0.14",
    "lint-staged": "16.4.0",
    "oxfmt": "0.42.0",
    "oxlint": "1.57.0",
    "playwright-extra": "^4.3.6",
    "postcss": "8.5.8",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "tailwindcss": "4.2.2",
    "test-proxy-recorder": "^1.3.0",
    "typescript": "6.0.2",
    "vite": "8.0.3",
    "vitest": "4.1.2",
    "web-ext": "^10.5.0"
  },
  "description": "See the country any X profile posts from — country flags, VPN warnings, and country filters, read from X's own data.",
  "intent": {
    "skills": [
      "test-proxy-recorder"
    ]
  },
  "license": "MIT",
  "author": {
    "name": "asmyshlyaev177",
    "email": "asmyshlyaev177+x-ext@gmail.com",
    "url": "https://x-pat.pages.dev/"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,html,json}": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx}": "oxlint --fix"
  }
}

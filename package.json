{
  "name": "X Profile Viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bedframe dev",
    "build": "bedframe build",
    "preview": "vite preview",
    "publish": "bedframe publish -b",
    "zip": "bedframe zip",
    "format": "oxfmt .",
    "lint": "oxlint --fix .",
    "fix": "npm run format && npm run lint",
    "test": "vitest run --coverage",
    "convert:safari": "xcrun safari-web-extension-converter dist/safari --project-location . --app-name $npm_package_name-safari"
  },
  "dependencies": {
    "idb-keyval": "^6.2.2",
    "preact": "^10.29.0"
  },
  "devDependencies": {
    "@bedframe/cli": "^0.1.2",
    "@bedframe/core": "^0.1.0",
    "@preact/preset-vite": "^2.10.4",
    "@tailwindcss/postcss": "4.2.2",
    "@tailwindcss/vite": "4.2.2",
    "@types/chrome": "0.1.38",
    "@types/node": "25.5.0",
    "@vitest/coverage-istanbul": "4.1.2",
    "concurrently": "9.2.1",
    "globals": "17.4.0",
    "happy-dom": "20.8.9",
    "lint-staged": "16.4.0",
    "oxfmt": "0.42.0",
    "oxlint": "1.57.0",
    "postcss": "8.5.8",
    "tailwindcss": "4.2.2",
    "typescript": "6.0.2",
    "vite": "8.0.3",
    "vitest": "4.1.2"
  },
  "description": "X Profile Viewer",
  "license": "UNLICENSED",
  "author": {
    "name": "asmyshlyaev177",
    "email": "asmyshlyaev177@gmail.com",
    "url": "https://asmyshlyaev177.dev"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,html,json}": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx}": "oxlint --fix"
  }
}

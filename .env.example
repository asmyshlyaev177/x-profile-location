# ensure you have these environment variables set in the project's

# Github Actions secrets and variables

# ^^^ https://github.com/<GITHUB_OWNER>/<GITHUB_REPO>/settings/secrets/actions

# Publish: Chrome Web Store

EXTENSION_ID=
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=

# Publish: AMO - Mozilla/Firefox Add-ons

WEB_EXT_API_KEY=
WEB_EXT_API_SECRET=

# Publish: MS Edge Add-ons (API v1.1 - January 2025)

EDGE_PRODUCT_ID=
EDGE_CLIENT_ID=
EDGE_API_KEY=

# Analytics
VITE_GA_MEASUREMENT_ID=
VITE_GA_API_SECRET=

# Shared location cache backend (see server/README.md).
# Unset  -> the default self-hosted Node+SQLite deployment (`pnpm build`).
# Set    -> any other backend, e.g. a Cloudflare Worker (`pnpm build:worker`)
#           or a local server for development, e.g. http://127.0.0.1:8787
# Empty  -> the shared cache is compiled out; the extension never calls a
#           server, and the options page hides the toggle (`pnpm build:nocache`).
# VITE_CACHE_API_BASE=


{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2023",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // `vitest/globals`, not `jest`: the suite runs on Vitest with `globals: true`
    // (see bedframe.config.ts), and @types/jest has never been installed here —
    // so the leftover entry from the template made `tsc -p tsconfig.app.json`
    // fail on TS2688 before it typechecked a single file, and describe/it/expect
    // resolved to nothing in every *.test.ts.
    "types": ["@bedframe/core", "vitest/globals", "@types/chrome"],
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "moduleResolution": "bundler",
    // The test setup imports `_locales/en/messages.json` to stand in for
    // `chrome.i18n`, which happy-dom has no equivalent for.
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"],
  "exclude": ["src/manifests", "src/_config/bedframe.config.ts"]
}

{
  "name": "x-pat-landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "generate:images": "node scripts/generate-images.mjs",
    "shoot:options": "node scripts/shoot-options.mjs",
    "build": "node scripts/generate-images.mjs && vite build && node scripts/flatten-routes.mjs && node scripts/minify-html.mjs",
    "preview": "vite preview --port 5173",
    "preview:lighthouse": "vite preview --port 5174 --strictPort",
    "test:lighthouse": "playwright test -c playwright.lighthouse.config.ts",
    "deploy": "wrangler pages deploy dist --project-name x-pat",
    "deploy:redirect": "wrangler pages deploy redirect --project-name x-profile-location"
  },
  "dependencies": {
    "preact": "^10.25.0",
    "preact-render-to-string": "^6.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@preact/preset-vite": "^2.10.4",
    "@tailwindcss/vite": "^4.2.2",
    "html-minifier-terser": "^7.2.0",
    "lighthouse": "^13.4.1",
    "playwright-lighthouse": "^4.0.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "vite-plugin-sitemap": "^0.8.2",
    "wrangler": "^4.0.0"
  }
}
